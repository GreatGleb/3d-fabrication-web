#!/usr/bin/env bash
# Локальная подготовка aiqme-site после клонирования (идемпотентно).
# storage/framework, storage/logs и bootstrap/cache исключены корневым .gitignore целиком,
# поэтому в клоне их нет — без них не работают package:discover и компиляция Blade.
set -euo pipefail
app_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$app_root"

mkdir -p bootstrap/cache storage/logs storage/framework/{cache/data,sessions,testing,views} \
    storage/app/private storage/app/public

# .env.example — шаблон рабочей среды (W-20); для разработки поверх него — локальные значения dev-compose и Mailpit.
if [[ ! -f .env ]]; then
    sed -e 's/^APP_ENV=.*/APP_ENV=local/' -e 's/^APP_DEBUG=.*/APP_DEBUG=true/' -e 's|^APP_URL=.*|APP_URL=http://localhost:8000|' \
        -e 's/^LOG_CHANNEL=.*/LOG_CHANNEL=stack/' -e 's/^LOG_LEVEL=.*/LOG_LEVEL=debug/' \
        -e 's/^DB_HOST=.*/DB_HOST=127.0.0.1/' -e 's/^DB_PORT=.*/DB_PORT=55440/' -e 's/^DB_PASSWORD=.*/DB_PASSWORD=local-dev-only-not-a-secret/' \
        -e 's/^SESSION_SECURE_COOKIE=.*/SESSION_SECURE_COOKIE=false/' \
        -e 's/^MAIL_HOST=.*/MAIL_HOST=127.0.0.1/' -e 's/^MAIL_PORT=.*/MAIL_PORT=51025/' \
        .env.example > .env
fi
# Ключ капчи ALTCHA (правка 28.10 П3): свой в каждой среде; дописывается, только если в .env его ещё нет или он пуст.
if ! grep -q '^ALTCHA_HMAC_KEY=.' .env; then
    sed -i '/^ALTCHA_HMAC_KEY=$/d' .env
    echo "ALTCHA_HMAC_KEY=$(openssl rand -hex 32)" >> .env
fi
bin/php /usr/local/bin/composer install --no-interaction
grep -q '^APP_KEY=base64:' .env || bin/php artisan key:generate --no-interaction
npm ci --no-audit --no-fund
docker compose -f docker-compose.dev.yml up -d --wait
bin/php artisan migrate --no-interaction
# Базовые данные Lunar для заявок (W-12): канал, языки, EUR, налоговые зона и класс; идемпотентно.
bin/php artisan aiqme:bootstrap --no-interaction
echo 'Готово. Администратор: bin/php artisan aiqme:make-admin <email> (D-29). Boost MCP: bin/boost-install.'
