EVIDENCE = REPO / 'docs' / 'customer-prototype' / 'evidence' / 'audit-20261016'
# Сидеры контента по порядку (исходный контент W-04); данные задач — tests/browser/
CONTENT_SEEDERS: list[str] = ['Database\\Seeders\\PrototypeContentSeeder']
