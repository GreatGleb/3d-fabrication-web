# Блоки эталона без нашей пары: демо-блоки и блок команды (как в prototype-blocks.json), расписание обучения (темы и даты —
# черновики, D-21: исключается всегда), подпись «● NN / label» над названием услуги (правка 28.10, П4: у нас её нет),
# ярлык над h1 блока page-top («AIQME», «AIQME / PASLAUGOS» и т. п.; правка 30.10, Г2: у нас его нет). Пятый элемент — дед
# узла: div.wrap есть и у hero главной, его ярлык остаётся.
TEXT_EXCLUDED_BLOCKS = [('div', {'notice'}), ('div', {'inset', 'gap'}, '/(lt/apie-mus|en/about)$'), ('div', {'grid', 'two'}, None, ('div', {'gap'})),
                        ('div', {'eyebrow'}, None, ('div', {'service-feature-copy'})),
                        ('div', {'eyebrow'}, None, ('div', {'wrap'}), ('section', {'page-top'}))]
NO_TEXT = {'script', 'style', 'template', 'noscript', 'svg'}


class ReferenceText(HTMLParser):
    """Текст main эталона по узлам (тег, классы, родитель) — только чтение dom.html как текста."""
    VOID = {'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'source', 'track', 'wbr'}

    def __init__(self):
        super().__init__()
        self.root = {'tag': 'root', 'cls': set(), 'children': [], 'parent': None}
        self.stack = [self.root]

    def handle_starttag(self, tag, attrs):
        node = {'tag': tag, 'cls': set((dict(attrs).get('class') or '').split()), 'children': [], 'parent': self.stack[-1]}
        self.stack[-1]['children'].append(node)
        if tag not in self.VOID:
            self.stack.append(node)

    def handle_endtag(self, tag):
        for i in range(len(self.stack) - 1, 0, -1):
            if self.stack[i]['tag'] == tag:
                del self.stack[i:]
                return

    def handle_data(self, data):
        self.stack[-1]['children'].append(data)


def reference_phrases(path, has_project):
    """Фразы видимого текста main эталона по порядку после исключений; None — эталона нет."""
    file = EVIDENCE / 'verified-route-screens' / (path.strip('/').replace('/', '__')) / 'dom.html'
    if not file.exists():
        return None
    parser = ReferenceText()
    parser.feed(file.read_text(encoding='utf-8'))

    def find(node):
        if isinstance(node, dict):
            if node['tag'] == 'main':
                return node
            for child in node['children']:
                found = find(child)
                if found:
                    return found
        return None

    def excluded(node):
        for rule in TEXT_EXCLUDED_BLOCKS:
            tag, classes = rule[0], rule[1]
            page_rule = rule[2] if len(rule) > 2 else None
            parent_rule = rule[3] if len(rule) > 3 else None
            grand_rule = rule[4] if len(rule) > 4 else None
            if node['tag'] == tag and node['cls'] == classes and (page_rule is None or re.search(page_rule, path)):
                parent = node['parent']
                grand = parent['parent'] or {'tag': None, 'cls': set()}
                if (parent_rule is None or (parent['tag'] == parent_rule[0] and parent['cls'] == parent_rule[1])) \
                        and (grand_rule is None or (grand['tag'] == grand_rule[0] and grand['cls'] == grand_rule[1])):
                    return True
        if 'project-card' in node['cls']:
            return True  # пример — карточка опубликованного проекта (данные, а не шаблон); без него не выводится (§4.1)
        if not has_project and node['tag'] == 'div' and node['cls'] == {'section-head'} and re.search(r'/(paslaugos|services)/', path):
            siblings = [c for c in node['parent']['children'] if isinstance(c, dict)]
            index = siblings.index(node)
            return index + 1 < len(siblings) and siblings[index + 1]['cls'] == {'grid', 'two'}
        return False

    phrases = []

    def walk(node):
        for child in node['children']:
            if isinstance(child, str):
                text = ' '.join(child.split())
                for original, replacement in D21_REPLACEMENTS:
                    text = text.replace(original, replacement)
                text = ' '.join(text.split())
                if text:
                    phrases.append(text)
            elif child['tag'] not in NO_TEXT and not excluded(child):
                walk(child)

    walk(find(parser.root))
    return phrases


OUR_TEXT = """() => {
    const walker = document.createTreeWalker(document.querySelector('main'), NodeFilter.SHOW_TEXT, {acceptNode: (node) =>
        node.parentElement.closest('script, style, template, noscript, [hidden]') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT});
    const parts = [];
    while (walker.nextNode()) { const text = walker.currentNode.nodeValue.replace(/\\s+/g, ' ').trim(); if (text) parts.push(text); }
    return parts.join(' ');
}"""


def check_text(report, page, path, allowlist, discrepancies):
    """Каждая фраза эталона (после исключений) есть в нашем main в том же порядке (done[8] W-05)."""
    phrases = reference_phrases(path, page.locator('main .project-card').count() > 0)
    if phrases is None:
        discrepancies.append(f'{path}: не проверено (нет эталона)')
        return
    allowed = {entry['phrase'] for entry in allowlist if entry['page'] == path}
    ours = page.evaluate(OUR_TEXT)
    position = 0
    for phrase in phrases:
        if phrase in allowed:
            continue
        found = ours.find(phrase, position)
        if report.check(found >= 0, f'{path}: нет фразы эталона «{phrase[:120]}» (после позиции {position})'):
            position = found + len(phrase)
        else:
            discrepancies.append(f'{path}: нет «{phrase}»')


# Ленивое изображение после прокрутки: ждём load/error (не дольше 5 с), затем decode.
LOADED = """const loaded = async (img) => {
    if (!img.complete) {
        await new Promise((resolve) => { img.addEventListener('load', resolve, {once: true});
            img.addEventListener('error', resolve, {once: true}); setTimeout(resolve, 5000); });
    }
    await img.decode().catch(() => {});
};"""

MEDIA_PROBE = """async () => {
    """ + LOADED + """
    const result = [];
    for (const frame of document.querySelectorAll('main .hero-art, main .service-feature-media, main .media-frame, main .split-image, main .project-image, main .gallery-view:not([hidden]), main .product-card .visual')) {
        frame.scrollIntoView({block: 'center'});
        const img = frame.querySelector(':scope > img');
        if (img) { await loaded(img); }
        const art = frame.querySelector(':scope > svg.placeholder-art');
        const box = art && art.getBoundingClientRect();
        result.push({frame: frame.className, image: img ? img.naturalWidth : null,
            art: !!(box && box.width > 0 && box.height > 0 && getComputedStyle(art).visibility === 'visible'),
            prototypeImage: [...frame.querySelectorAll('img')].some((i) => /\\/assets\\//.test(i.src))});
    }
    window.scrollTo(0, 0);
    return result;
}"""


def check_media(report, page, path):
    """Медиа или своя заглушка отрисованы (naturalWidth > 0 либо видимый SVG); изображений прототипа нет (§7.2, F-47)."""
    for frame in page.evaluate(MEDIA_PROBE):
        report.check((frame['image'] or 0) > 0 or frame['art'], f'{path}: медиа не отрисовано в {frame}')
        report.check(not frame['prototypeImage'], f'{path}: изображение прототипа в {frame["frame"]}')


MOTION_PROBE = """() => {
    const video = document.getElementById('hero-video');
    const tracks = [...document.querySelectorAll('.partner-marquee-track, .news-marquee-track')];
    return {
        video: video && {paused: video.paused, autoplay: video.hasAttribute('autoplay'), poster: video.poster, preload: video.preload,
            visible: video.getBoundingClientRect().height > 0, mobile: [...video.querySelectorAll('source')].map((s) => s.media)},
        tracks: tracks.map((t) => ({animation: getComputedStyle(t).animationName,
            duplicates: [...t.querySelectorAll('[aria-hidden="true"]')].filter((g) => g.getBoundingClientRect().width > 0).length,
            transform: getComputedStyle(t).transform})),
    };
}"""


DEFAULTS_PROBE = """async (selector) => {
    """ + LOADED + """
    const result = [];
    for (const element of document.querySelectorAll(selector)) {
        element.scrollIntoView({block: 'center'});
        if (element.tagName === 'IMG') {
            await loaded(element);
            result.push({src: element.getAttribute('src'), drawn: element.naturalWidth > 0, alt: element.getAttribute('alt')});
        } else {
            result.push({src: element.getAttribute('poster'), drawn: element.getBoundingClientRect().height > 0,
                sources: [...element.querySelectorAll('source')].map((s) => s.getAttribute('src'))});
        }
    }
    window.scrollTo(0, 0);
    return result;
}"""


def check_defaults(report, page, path, width):
    """Места D-43 без загруженных медиа берут файл из /defaults/ и отрисованы (W-33)."""
    for selector in DEFAULT_MEDIA[path]:
        found = page.evaluate(DEFAULTS_PROBE, selector)
        where = f'{path} @{width} {selector}'
        if report.check(len(found) > 0, f'{where}: нет элемента'):
            for element in found:
                files = [element['src'], *element.get('sources', [])]
                report.check(all('/defaults/' in (file or '') for file in files), f'{where}: не файл по умолчанию {element}')
                report.check(element['drawn'], f'{where}: не отрисовано {element}')


def check_motion(report, browser, new_page, path):
    """Видео hero и ленты (§7.3) на данных фабрик: с reduced-motion — пауза, без autoplay, постер, лента без анимации
    и дублей; без него — видео играет, лента движется, кнопка паузы её останавливает."""
    context, page, _ = new_page(1440, 1000, reduced_motion='reduce')
    page.goto(BASE + path, wait_until='networkidle')
    page.wait_for_timeout(800)
    got = page.evaluate(MOTION_PROBE)
    video = got['video']
    if report.check(video is not None, f'{path}: нет видео hero'):
        report.check(video['paused'] and not video['autoplay'], f'{path} reduced-motion: видео играет или autoplay {video}')
        report.check(bool(video['poster']) and video['visible'], f'{path} reduced-motion: нет постера {video}')
        if video['poster']:
            report.check(page.request.get(video['poster']).status == 200, f'{path}: постер не загружается {video["poster"]}')
        report.check(video['preload'] == 'metadata' and '(max-width: 700px)' in video['mobile'], f'{path}: preload/мобильный источник {video}')
    report.check(len(got['tracks']) == 2, f'{path}: ожидались ленты брендов и новостей (данные фабрик), найдено {len(got["tracks"])}')
    for track in got['tracks']:
        report.check(track['animation'] == 'none' and track['duplicates'] == 0, f'{path} reduced-motion: лента {track}')
    context.close()

    context, page, _ = new_page(1440, 1000)
    page.goto(BASE + path, wait_until='networkidle')
    page.mouse.move(1, 1)
    try:
        page.wait_for_function("() => { const v = document.getElementById('hero-video'); return v && !v.paused; }", timeout=5000)
        report.check(True, '')
    except Exception:  # noqa: BLE001 — таймаут ожидания и есть провал проверки
        report.check(False, f'{path}: без reduced-motion видео hero не играет')
    for selector in ('.partner-section', '.news-section'):
        track = page.locator(f'{selector} [class$="-marquee-track"]')
        before = track.evaluate('(t) => getComputedStyle(t).transform')
        page.wait_for_timeout(400)
        moved = track.evaluate('(t) => getComputedStyle(t).transform')
        report.check(before != moved, f'{path}: лента {selector} не движется')
        page.locator(f'{selector} .partner-motion-toggle').click()
        page.mouse.move(1, 1)
        stopped = track.evaluate('(t) => getComputedStyle(t).transform')
        page.wait_for_timeout(400)
        report.check(stopped == track.evaluate('(t) => getComputedStyle(t).transform'), f'{path}: пауза не остановила ленту {selector}')
        report.check(page.locator(f'{selector} .partner-motion-toggle').get_attribute('aria-pressed') == 'true', f'{path}: aria-pressed паузы {selector}')
    context.close()


SELF_TEST_PATH = '/__browser-check-self-test'


def self_test(report, browser, csp, assets):
    """Детекторы ловят нарушения: маркер, CSP, переполнение; модальное окно — на настоящем JS приложения."""
    context = browser.new_context(viewport={'width': 390, 'height': 844})
    page = context.new_page()
    console = []
    page.on('console', lambda message: console.append(message.text))
    body = f"""<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">{assets}</head><body>
<header class="header"><div class="wrap head-main"></div></header>
<main id="main"><h1>Demonstration website</h1><p style="width:1200px">wide</p><div class="page-content">no side padding</div>
<script>window.inlineRan = true;</script>
<button id="opener" data-modal-open="dialog">Open</button><a href="#x" id="outside">Outside</a>
<div class="search-overlay" id="dialog" data-modal hidden><section class="search-panel" role="dialog" aria-modal="true" aria-labelledby="dialog-title">
<button type="button" data-modal-close aria-label="Close">×</button><h2 id="dialog-title">Title</h2>
<input name="first" aria-label="First"><button type="button" id="last">Last</button></section></div></main></body></html>"""
    page.route(BASE + SELF_TEST_PATH, lambda route: route.fulfill(status=200, body=body,
               headers={'Content-Type': 'text/html; charset=utf-8', 'Content-Security-Policy': csp}))
    page.goto(BASE + SELF_TEST_PATH)
    page.wait_for_load_state('networkidle')
    scroll, client = document_fits(page)
    report.check(scroll > client, 'самопроверка: переполнение документа не обнаружено')
    report.check(any('Content Security Policy' in text for text in console) and not page.evaluate('window.inlineRan === true'),
                 'самопроверка: inline-скрипт без nonce не заблокирован CSP или нарушение не видно в консоли')
    report.check(any('demonstr' in hit for hit in marker_hits(page, SELF_TEST_PATH, [])), 'самопроверка: маркер «Demonstration» не найден')
    report.check(marker_hits(page, SELF_TEST_PATH, [{'page': SELF_TEST_PATH, 'phrase': 'Demonstration website'}]) == [],
                 'самопроверка: точная фраза из allowlist не разрешила совпадение')
    gutters = Report()
    check_gutters(gutters, page, SELF_TEST_PATH, 390)
    report.check(any(': поля контента 0/0 ' in failure for failure in gutters.failures), 'самопроверка: нулевые поля контента не обнаружены')

    page.locator('#opener').click()
    dialog = page.locator('#dialog')
    report.check(dialog.is_visible(), 'модальное окно: не открылось')
    report.check(page.evaluate("document.activeElement.matches('[data-modal-close]')"), 'модальное окно: фокус не внутри')
    report.check(page.evaluate("document.querySelector('main').inert === true"), 'модальное окно: фон не inert')
    page.locator('#last').focus()
    page.keyboard.press('Tab')
    report.check(page.evaluate("document.activeElement.matches('[data-modal-close]')"), 'модальное окно: Tab вышел из окна')
    page.keyboard.press('Shift+Tab')
    report.check(page.evaluate("document.activeElement.id === 'last'"), 'модальное окно: Shift+Tab вышел из окна')
    page.keyboard.press('Escape')
    report.check(not dialog.is_visible(), 'модальное окно: Escape не закрыл')
    report.check(page.evaluate("document.activeElement.id === 'opener'"), 'модальное окно: фокус не вернулся на кнопку')
    report.check(page.evaluate("document.querySelector('main').inert === false"), 'модальное окно: фон остался inert')
    page.locator('#opener').click()
    page.mouse.click(5, 5)
    report.check(not dialog.is_visible(), 'модальное окно: щелчок по фону не закрыл')
    context.close()


# ---------- вход через форму (W-07) ----------

def sign_in(report, new_page, login_path, email, password, expect_path):
    """Вход через форму входа кабинета; возвращает storage_state вошедшего браузера (cookie сессии)."""
    context, page, problems = new_page(1440, 1000)
    page.goto(BASE + login_path, wait_until='networkidle')
    page.fill('#auth-form input[name=email]', email)
    page.fill('#auth-form input[name=password]', password)
    with page.expect_navigation(wait_until='networkidle'):
        page.click('#auth-form button[type=submit]')
    report.check(urlparse(page.url).path == expect_path, f'вход {email} через {login_path}: открылся {page.url}, ожидался {expect_path}')
    for problem in problems:
        report.check(False, f'вход {email}: {problem}')
    state = context.storage_state()
    context.close()
    return state


def check_private_pages(report, new_page, paths, state, selector, allowlist, who):
    """Страницы после входа: 200, нужный блок (а не форма входа), ширина, §7.1, маркеры D-21, консоль."""
    for path in paths:
        for width in WIDTHS:
            height = {320: 568, 390: 844, 768: 1024, 1024: 768, 1440: 1000}[width]
            context, page, problems = new_page(width, height, storage_state=state)
            response = page.goto(BASE + path, wait_until='networkidle')
            where = f'{path} @{width} ({who})'
            report.check(response.status == 200, f'{where}: HTTP {response.status}')
            report.check(page.locator(selector).count() == 1, f'{where}: нет {selector}')
            report.check(page.locator('#auth-form').count() == 0, f'{where}: форма входа вместо страницы')
            scroll, client = document_fits(page)
            report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
            check_gutters(report, page, where, width)
            if width in STYLE_WIDTHS:
                check_styles(report, page, path, width)
            if width in (390, 1440):
                for hit in marker_hits(page, path, allowlist):
                    report.check(False, f'{where}: маркер {hit}')
                # Кадр после входа — для ручного просмотра (в report.html не входит).
                page.screenshot(path=str(OUT / 'shots' / f'{path.strip("/").replace("/", "__")}-signed-in-{width}.png'))
            for problem in problems:
                report.check(False, f'{where}: {problem}')
            context.close()


def check_status(report, new_page, paths, state, status, who):
    for path in paths:
        context, page, _ = new_page(1440, 1000, storage_state=state)
        response = page.goto(BASE + path, wait_until='networkidle')
        report.check(response.status == status, f'{path} ({who}): HTTP {response.status}, ожидался {status}')
        context.close()


def check_russian(report, new_page, paths, state):
    """/ru/ — только администратору: 200, X-Robots-Tag и meta robots noindex, ширина документа на 320/390/768/1024/1440
    (матрица LT/EN/RU × 5 ширин §9.2, W-21)."""
    for path in paths:
        for width in WIDTHS:
            height = {320: 568, 390: 844, 768: 1024, 1024: 768, 1440: 1000}[width]
            where = f'{path} @{width} (администратор)'
            context, page, problems = new_page(width, height, storage_state=state)
            response = page.goto(BASE + path, wait_until='networkidle')
            report.check(response.status == 200, f'{where}: HTTP {response.status}')
            report.check('noindex' in (response.headers.get('x-robots-tag') or ''), f'{where}: нет X-Robots-Tag noindex')
            robots = page.locator('meta[name=robots]').get_attribute('content') or ''
            report.check('noindex' in robots, f'{where}: meta robots «{robots}»')
            scroll, client = document_fits(page)
            report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
            check_gutters(report, page, where, width)
            for problem in problems:
                report.check(False, f'{where}: {problem}')
            context.close()


def check_profile_and_logout(report, new_page, state):
    """Профиль сохраняется и показывается снова; выход ведёт на вход, кабинет после выхода — форма входа."""
    context, page, problems = new_page(1440, 1000, storage_state=state)
    page.goto(BASE + '/lt/paskyra/addresses', wait_until='networkidle')
    page.fill('#address-form input[name=company]', 'UAB Detalė')
    page.fill('#address-form input[name=city]', 'Vilnius')
    with page.expect_navigation(wait_until='networkidle'):
        page.click('#address-form button[type=submit]')
    report.check(page.locator('#address-form [role=status]').inner_text().strip() == 'Duomenys išsaugoti.', 'профиль: нет «Duomenys išsaugoti.»')
    page.reload(wait_until='networkidle')
    report.check(page.input_value('#address-form input[name=company]') == 'UAB Detalė', 'профиль: значение не сохранилось')
    with page.expect_navigation(wait_until='networkidle'):
        page.click('.side-nav button[form=logout-form]')
    report.check(urlparse(page.url).path == '/lt/paskyra/login', f'выход: открылся {page.url}')
    page.goto(BASE + '/lt/paskyra/addresses', wait_until='networkidle')
    report.check(page.locator('#auth-form').count() == 1 and page.locator('#address-form').count() == 0, 'после выхода кабинет открыт')
    for problem in problems:
        report.check(False, f'профиль и выход: {problem}')
    context.close()


def png_file(directory, name, width=64, height=32):
    """PNG без внешних библиотек (zlib): файл с чужим именем проверяет определение формата по сигнатуре (§6.4)."""
    import struct
    import zlib
    rows = b''.join(b'\x00' + bytes([8, 103, 255]) * width for _ in range(height))
    chunk = lambda kind, data: struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))  # noqa: E731
    path = Path(directory) / name
    path.write_bytes(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
                     + chunk(b'IDAT', zlib.compress(rows)) + chunk(b'IEND', b''))
    return path


def check_admin_editor(report, new_page, state):
    """Общий редактор W-08 в браузере (Livewire, CSP): открытие из списка на 390 и 1440 без расползания; на 1440 —
    черновик → публикация EN → текст на публичной странице; PNG с именем x.html → имя UUID.png и картинка на странице
    услуги; правка той же услуги во втором окне → в первом сообщение о конфликте, введённый текст на месте."""
    for width, height in ((390, 844), (1440, 1000)):
        for path, row in (('/en/admin/services', 'scanning'), ('/lt/administravimas/content', 'home')):
            where = f'{path} @{width} редактор'
            context, page, problems = new_page(width, height, storage_state=state)
            page.goto(BASE + path, wait_until='networkidle')
            page.locator('main table a.btn').first.click()
            page.wait_for_load_state('networkidle')
            report.check(page.locator('#content-edit-form').count() == 1, f'{where}: редактор не открылся')
            scroll, client = document_fits(page)
            report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
            for problem in problems:
                report.check(False, f'{where}: {problem}')
            context.close()

    where = 'редактор услуги @1440'
    context, page, problems = new_page(1440, 1000, storage_state=state)
    page.goto(BASE + '/en/admin/services', wait_until='networkidle')
    page.locator('main table a.btn').first.click()
    page.wait_for_load_state('networkidle')
    short = '#field-form-en-fields-short'
    original = page.input_value(short)
    page.fill(short, 'Checked by the browser.')
    page.click('#content-edit-form button[type=submit]')
    page.wait_for_selector('#content-edit-form .notice.success:has-text("Draft saved.")')
    public = page.context.new_page()
    public.goto(BASE + '/en/services/3d-scanning', wait_until='networkidle')
    report.check('Checked by the browser.' not in public.inner_text('main'), f'{where}: черновик виден на сайте')
    page.click('button:has-text("Publish EN")')
    page.wait_for_selector('#content-edit-form .notice.success:has-text("Published: EN.")')
    public.reload(wait_until='networkidle')
    report.check('Checked by the browser.' in public.inner_text('main'), f'{where}: опубликованный текст не виден на сайте')

    default = '/defaults/services/scanning.png'
    report.check(page.locator(f'#content-media img[src$="{default}"]').count() == 1, f'{where}: нет превью умолчания до загрузки (W-33)')
    with tempfile.TemporaryDirectory() as directory:
        page.set_input_files('#field-upload', str(png_file(directory, 'x.html', 1200, 600)))
        page.wait_for_load_state('networkidle')
        page.fill('#field-alt-en', 'Scanned part')
        page.click('#media-upload-form button[type=submit]')
        page.wait_for_selector('#content-editor .notice.success:has-text("File uploaded.")')
    links = page.locator('#content-media a.text-link').all_inner_texts()
    report.check(len(links) == 1 and re.fullmatch(r'[0-9a-f-]{36}\.png ↗', links[0] if links else ''), f'{where}: имя файла {links}')
    public.reload(wait_until='networkidle')
    image = public.locator('main img[alt="Scanned part"]')
    report.check(image.count() == 1 and image.evaluate('(img) => img.complete && img.naturalWidth > 0'), f'{where}: загруженное фото не показано')

    # Второе окно сохраняет ту же услугу раньше — первое получает сообщение о конфликте, ввод не теряется.
    other_context, other, other_problems = new_page(1440, 1000, storage_state=state)
    other.goto(page.url, wait_until='networkidle')
    other.fill(short, 'Saved in the second window.')
    other.click('#content-edit-form button[type=submit]')
    other.wait_for_selector('#content-edit-form .notice.success:has-text("Draft saved.")')
    page.fill(short, 'Typed in the first window.')
    page.click('#content-edit-form button[type=submit]')
    page.wait_for_selector('#content-edit-form .notice.error')
    report.check('Changed in another window' in page.inner_text('#content-edit-form .notice.error'), f'{where}: нет сообщения о конфликте')
    report.check(page.input_value(short) == 'Typed in the first window.', f'{where}: введённый текст потерян при конфликте')
    scroll, client = document_fits(page)
    report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
    # Возврат исходного текста: страница услуги дальше сверяется с эталоном (публикация сохраняет изменённый язык).
    other.reload(wait_until='networkidle')
    other.fill(short, original)
    other.click('button:has-text("Publish EN")')
    other.wait_for_selector('#content-edit-form .notice.success:has-text("Published: EN.")')
    # W-33: удаление своего файла возвращает умолчание D-43 в редакторе и на сайте (дальше проверяются места умолчаний).
    other.click('#content-media button:has-text("Remove")')
    other.wait_for_selector('#content-editor .notice.success:has-text("File removed.")')
    report.check(other.locator(f'#content-media img[src$="{default}"]').count() == 1, f'{where}: превью умолчания не вернулось после удаления')
    public.reload(wait_until='networkidle')
    report.check(public.locator(f'main .media-frame > img[src$="{default}"]').count() == 1, f'{where}: умолчание не вернулось на страницу услуги')
    for problem in problems + other_problems:
        report.check(False, f'{where}: {problem}')
    other_context.close()
    context.close()


def check_admin_editors_w26(report, new_page, state):
    """Редакторы W-26 в браузере: проект (атрибуты элемента), новая статья (разделы-записи), строка интерфейса — открываются на
    390 и 1440 без расползания и ошибок консоли/CSP; на 1440 правка ui_text shell.nav.services видна в шапке сайта, затем
    пустое поле возвращает текст файла."""
    for width, height in ((390, 844), (1440, 1000)):
        for path, form in (('/en/admin/projects', '#content-meta'), ('/lt/administravimas/content?new=article', '#content-edit-form'),
                           ('/en/admin/translations?edit=shell.nav.services', '#ui-text-form')):
            where = f'{path} @{width} редактор W-26'
            context, page, problems = new_page(width, height, storage_state=state)
            page.goto(BASE + path, wait_until='networkidle')
            if 'edit=' not in path and 'new=' not in path:
                page.locator('main table a.btn').first.click()
                page.wait_for_load_state('networkidle')
            report.check(page.locator(form).count() == 1, f'{where}: нет {form}')
            scroll, client = document_fits(page)
            report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
            for problem in problems:
                report.check(False, f'{where}: {problem}')
            context.close()

    where = 'ui_text @1440'
    context, page, problems = new_page(1440, 1000, storage_state=state)
    page.goto(BASE + '/en/admin/translations?edit=shell.nav.services', wait_until='networkidle')
    page.fill('#field-values-en', 'Our services')
    page.click('#ui-text-form button[type=submit]')
    page.wait_for_selector('#ui-text-form .notice.success:has-text("Saved.")')
    public = page.context.new_page()
    public.goto(BASE + '/en', wait_until='networkidle')
    report.check('Our services' in public.inner_text('header'), f'{where}: правка не видна в шапке')
    page.fill('#field-values-en', '')
    # «Saved.» первого сохранения остаётся на экране — ждём ответ Livewire второго, иначе шапка читается до записи.
    with page.expect_response(lambda r: r.request.method == 'POST' and 'livewire' in r.url):
        page.click('#ui-text-form button[type=submit]')
    page.wait_for_selector('#ui-text-form .notice.success:has-text("Saved.")')
    public.reload(wait_until='networkidle')
    report.check('Our services' not in public.inner_text('header') and 'Services' in public.inner_text('header'),
                 f'{where}: текст файла не вернулся')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def check_calculator_settings(report, new_page, state):
    """Вкладка настроек калькулятора (W-11) в браузере: форма на 390 и 1440 без расползания и ошибок консоли/CSP; на 1440
    у габарита нет пометки «Not confirmed» (П7: 1000 мм подтверждён), сохранение 300 и затем 1000 через Livewire видно
    в data-settings /en/quote и в тексте шага 3; в конце габарит — 1000."""
    for width, height in ((390, 844), (1440, 1000)):
        where = f'/en/admin/calculator @{width}'
        context, page, problems = new_page(width, height, storage_state=state)
        page.goto(BASE + '/en/admin/calculator', wait_until='networkidle')
        report.check(page.locator('#pricing-form').count() == 1, f'{where}: нет #pricing-form')
        scroll, client = document_fits(page)
        report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
        if width == 1440:
            report.check('Build size, mm · Not confirmed' not in page.inner_text('#pricing-form'), f'{where}: у габарита пометка до сохранения')
            report.check(page.input_value('#field-maxDimension') == '1000', f'{where}: габарит не 1000 мм')
            for value in ('300', '1000'):
                page.fill('#field-maxDimension', value)
                # Плашка «Saved.» прошлого сохранения ещё видна — ждём ответ именно этого запроса Livewire.
                with page.expect_response(lambda r: r.request.method == 'POST' and 'livewire' in r.url):
                    page.click('#pricing-form button[type=submit]')
                page.wait_for_selector('#pricing-form .notice.success:has-text("Saved.")')
                public = page.context.new_page()
                public.goto(BASE + '/en/quote', wait_until='networkidle')
                shown = json.loads(public.get_attribute('#quote', 'data-settings'))['max_dimension_mm']
                report.check(shown == int(value), f'{where}: на /en/quote габарит {shown}, сохранено {value}')
                text = f'FDM: {value} × {value} × {value} mm.'
                report.check(text in public.locator('[data-step-panel="2"]').text_content(), f'{where}: на /en/quote нет «{text}»')
                public.close()
            report.check('Not confirmed' not in page.locator('#field-maxDimension').locator('xpath=..').inner_text(),
                         f'{where}: у габарита пометка после сохранения')
        for problem in problems:
            report.check(False, f'{where}: {problem}')
        context.close()


def check_admin_order(report, new_page, state, allowlist):
    """Карточка заказа W-14 на фабричном заказе (tests/browser/OrderFactory) на 390 (LT) и 1440 (EN); notes клиента
    (E-05) — #order-notes из двух строк без разметки, видны на кадре admin-order-card-<ширина>.png."""
    for width, height, prefix, texts in ((390, 844, '/lt/administravimas', {'stage': 'Patvirtinta gamybai', 'open': 'Atvira', 'back': 'Atgal'}),
                                         (1440, 1000, '/en/admin', {'stage': 'Approved for production', 'open': 'Open', 'back': 'Back'})):
        where = f'{prefix}/orders карточка @{width}'
        context, page, problems = new_page(width, height, storage_state=state)
        page.goto(BASE + prefix + '/orders', wait_until='networkidle')
        page.locator('#admin-order-list a.btn').last.click()  # гостевой заказ фабрики — самый старый (заказы клиента W-15 новее)
        page.wait_for_load_state('networkidle')
        if not report.check(page.locator('#order-card').count() == 1, f'{where}: нет #order-card'):
            context.close()
            continue
        path = urlparse(page.url).path + '?' + urlparse(page.url).query
        report.check(texts['stage'] in page.inner_text('#order-card .status-title'), f'{where}: нет стадии «{texts["stage"]}»')
        report.check(texts['open'] in page.inner_text('#order-payment'), f'{where}: нет открытого запроса оплаты')
        report.check(page.input_value('#field-trackingNumber') == 'LT000000001', f'{where}: нет трека')
        # notes клиента (E-05): две строки, без разметки.
        notes = page.locator('#order-notes')
        report.check(notes.count() == 1 and notes.inner_text() == 'Pagaminti iki penktadienio.\nDetales supakuoti atskirai.'
                     and notes.locator('br').count() == 1 and notes.locator('*:not(br)').count() == 0,
                     f'{where}: #order-notes {notes.all_inner_texts()}')
        page.click('#order-card button[aria-controls="bambu-job"]')
        page.wait_for_selector('#bambu-job')
        links = page.locator('#bambu-job a').evaluate_all('links => links.map(link => link.getAttribute("href"))')
        report.check(len(links) == 2 and all(re.fullmatch(re.escape(BASE) + r'/stl/\d+', link or '') for link in links),
                     f'{where}: ссылки листа задания {links}')
        if links:
            response = page.request.get(links[0])
            report.check(response.status == 200 and response.headers.get('content-disposition', '').startswith('attachment'),
                         f'{where}: скачивание STL {response.status} {response.headers.get("content-disposition")}')
        scroll, client = document_fits(page)
        report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
        for hit in marker_hits(page, path, allowlist):
            report.check(False, f'{where}: маркер {hit}')
        page.click('#order-cancel-form button[type=submit]')
        page.wait_for_selector('#order-confirm')
        page.click(f'#order-confirm button:has-text("{texts["back"]}")')
        page.wait_for_selector('#order-confirm', state='detached')
        report.check(texts['stage'] in page.inner_text('#order-card .status-title'), f'{where}: заказ изменился после «{texts["back"]}»')
        page.screenshot(path=str(OUT / 'shots' / f'admin-order-card-{width}.png'), full_page=True)
        if width == 1440:
            with page.expect_response(lambda r: r.request.method == 'POST' and 'livewire' in r.url):
                page.click('#order-guest-link button')
            page.wait_for_selector('#guest-link')
            link = page.get_attribute('#guest-link', 'href') or ''
            guest_context, guest_page, guest_problems = new_page(1440, 1000)
            response = guest_page.goto(link, wait_until='networkidle')
            report.check(response.status == 200 and guest_page.locator('[data-order-number]').count() == 1,
                         f'{where}: новая гостевая ссылка — HTTP {response.status}')
            for problem in guest_problems:
                report.check(False, f'{where} гостевая страница: {problem}')
            guest_context.close()
            page.reload(wait_until='networkidle')
            report.check(page.locator('#guest-link').count() == 0 and link not in page.content(), f'{where}: ссылка показана повторно')
        for problem in problems:
            report.check(False, f'{where}: {problem}')
        context.close()


def quote_from_saved_model(report, page, where, en):
    """Калькулятор, открытый из кабинета с ?models=: модель скачана защищённой выдачей и разобрана; PLA, 100 %, qty 1 →
    на шаге 4 итог 5,12 (D-09)."""
    try:
        page.wait_for_selector('[data-model]:not([hidden])', timeout=15000)
    except Exception:
        report.check(False, f'{where}: модель из кабинета не загрузилась в калькулятор')
        return False
    row = page.locator('[data-files] .file-row').all_inner_texts()
    report.check(len(row) == 1 and 'cube-10mm-binary.stl' in row[0], f'{where}: строки файлов {row}')
    report.check(page.locator('#quote-error .notice').count() == 0, f'{where}: ошибка «{page.locator("#quote-error").inner_text()}»')
    for step in range(3):
        page.locator('[data-next]').evaluate('(node) => node.scrollIntoView({block: "center"})')
        page.click('[data-next]')
        if step == 0:
            page.select_option('select[name=material]', 'PLA')
            page.select_option('select[name=infill]', '100')
            report.check(page.locator('[data-quantity]').input_value() == '1', f'{where}: количество не 1')
    total = page.locator('[data-total]').inner_text().replace('\xa0', ' ')
    expected = '€5.12' if en else '5,12 €'
    report.check(total == expected, f'{where}: итог шага 4 «{total}» вместо «{expected}»')
    scroll, client = document_fits(page)
    report.check(scroll <= client, f'{where}: шаг 4 шире окна ({scroll} > {client})')
    return total == expected


def check_customer_orders(report, new_page, state, guest_url, allowlist):
    """W-15 на фабричных заказах (tests/browser/OrderFactory): карточка заказа клиента (стадия, аванс, сообщение и ответ),
    «пересчитать» в Saved models (390, LT) и повторный заказ из карточки (1440, EN) — модель загружена в калькулятор, итог
    5,12, отправка создаёт новый заказ с новой моделью; гостевая страница по ссылке — карточка и скачивание STL по праву
    в сессии, чистый браузер без ссылки — 404 на STL; кнопка оплаты гостевой страницы — страница оплаты W-16 (чистый
    браузер — 404). Ширина, маркеры D-21, консоль на 390 и 1440."""
    def fits(page, where, path):
        scroll, client = document_fits(page)
        report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
        for hit in marker_hits(page, path, allowlist):
            report.check(False, f'{where}: маркер {hit}')

    for width, height, prefix, texts in ((390, 844, '/lt/paskyra', {'stage': 'Patvirtinta gamybai', 'paid': '10,00 €', 'recorded': 'Jūsų pasirinkimas užfiksuotas'}),
                                         (1440, 1000, '/en/account', {'stage': 'Approved for production', 'paid': '€10.00', 'recorded': 'Your choice has been recorded'})):
        where = f'{prefix}/orders карточка @{width}'
        context, page, problems = new_page(width, height, storage_state=state)
        page.goto(BASE + prefix + '/orders', wait_until='networkidle')
        with page.expect_navigation(wait_until='networkidle'):
            page.locator('#account-orders a.btn').first.click()
        path = urlparse(page.url).path
        if not report.check(page.locator('#customer-order').count() == 1, f'{where}: нет #customer-order ({page.url})'):
            context.close()
            continue
        report.check(texts['stage'] in page.inner_text('#customer-order .status-title'), f'{where}: нет стадии «{texts["stage"]}»')
        paid = page.inner_text('[data-paid]').replace('\xa0', ' ')
        report.check(texts['paid'] in paid, f'{where}: оплачено «{paid}»')
        report.check(page.locator('[data-transaction=capture]').count() == 1, f'{where}: нет поступившего платежа')
        report.check(page.locator('#order-reply button').count() == 3, f'{where}: нет трёх кнопок ответа')
        fits(page, where, path)
        page.screenshot(path=str(OUT / 'shots' / f'account-order-card-{width}.png'), full_page=True)
        if width == 1440:
            with page.expect_navigation(wait_until='networkidle'):
                page.click('#order-reply button[value=question]')
            report.check(page.locator('[data-reply=question]').count() == 1 and texts['recorded'] in page.inner_text('#customer-order'),
                         f'{where}: ответ клиента не записан')
        for problem in problems:
            report.check(False, f'{where}: {problem}')
        context.close()

    # «Пересчитать» в Saved models (390, LT): калькулятор с ?models=<id>.
    where = '/lt/paskyra/models пересчитать @390'
    context, page, problems = new_page(390, 844, storage_state=state)
    page.add_init_script('HTMLCanvasElement.prototype.getContext = () => null;')
    page.goto(BASE + '/lt/paskyra/models', wait_until='networkidle')
    fits(page, where, '/lt/paskyra/models')
    with page.expect_navigation(wait_until='networkidle'):
        page.locator('[data-recalculate]').first.click()
    report.check(re.search(r'[?&]models=\d+$', page.url) is not None, f'{where}: адрес калькулятора {page.url}')
    quote_from_saved_model(report, page, where, en=False)
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()

    # Повторный заказ из карточки (1440, EN): итог 5,12 и отправка — новый заказ и новая модель в кабинете.
    where = '/en/account повторный заказ @1440'
    context, page, problems = new_page(1440, 1000, storage_state=state)
    page.add_init_script('HTMLCanvasElement.prototype.getContext = () => null;')
    page.goto(BASE + '/en/account', wait_until='networkidle')
    counts = {name: page.inner_text(f'[data-count={name}]') for name in ('orders', 'models')}
    page.locator('#account-overview a.btn').first.click()
    page.wait_for_load_state('networkidle')
    with page.expect_navigation(wait_until='networkidle'):
        page.click('[data-reorder]')
    if quote_from_saved_model(report, page, where, en=True):
        page.locator('[data-next]').evaluate('(node) => node.scrollIntoView({block: "center"})')
        page.click('[data-next]')
        page.select_option('select[name=delivery]', 'pickup')
        page.fill('#checkout-form [name=phone]', '+370 600 00003')
        page.locator('#checkout-form button[type=submit]').evaluate('(node) => node.scrollIntoView({block: "center"})')
        page.click('#checkout-form button[type=submit]')
        page.wait_for_url('**/quote/submitted', timeout=30000)
        page.wait_for_load_state('networkidle')
        report.check(int(page.locator('[data-total]').get_attribute('data-cents') or -1) == 512, f'{where}: сумма новой заявки не 5,12')
        page.goto(BASE + '/en/account', wait_until='networkidle')
        after = {name: page.inner_text(f'[data-count={name}]') for name in ('orders', 'models')}
        report.check(all(int(after[name]) == int(counts[name]) + 1 for name in counts), f'{where}: счётчики до {counts}, после {after}')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()

    # Гостевая страница: карточка по ссылке, STL — по праву в сессии; чистый браузер без ссылки — 404.
    stl = None
    for width, height in ((390, 844), (1440, 1000)):
        where = f'гостевая страница @{width}'
        context, page, problems = new_page(width, height)
        response = page.goto(BASE + guest_url, wait_until='networkidle')
        report.check(response.status == 200 and page.locator('#customer-order').count() == 1, f'{where}: HTTP {response.status}')
        report.check(page.locator('[data-reorder]').count() == 0, f'{where}: ссылка повторного заказа')
        fits(page, where, guest_url)
        links = page.locator('#customer-order a[href*="/stl/"]').evaluate_all('links => links.map(link => link.href)')
        report.check(len(links) == 2, f'{where}: ссылки STL {links}')
        if links:
            stl = links[0]
            answer = page.request.get(stl)
            report.check(answer.status == 200 and answer.headers.get('content-disposition', '').startswith('attachment'), f'{where}: скачивание STL гостем {answer.status}')
        page.screenshot(path=str(OUT / 'shots' / f'guest-order-{width}.png'), full_page=True)
        # W-16: кнопка оплаты открытого запроса ведёт на страницу оплаты по праву в сессии (без ключей Stripe —
        # «оплата временно недоступна», Payment Element на уровне L не проверяется — W-22).
        checkout = page.locator('a[data-checkout-link]')
        report.check(checkout.count() == 1, f'{where}: кнопок оплаты {checkout.count()}')
        if checkout.count() == 1:
            checkout_url = checkout.get_attribute('href')
            checkout.click()
            page.wait_for_load_state('networkidle')
            report.check(page.locator('#checkout[data-checkout-status="unavailable"]').count() == 1, f'{where}: страница оплаты {page.url}')
            fits(page, f"страница оплаты @{width}", urlparse(checkout_url).path)
            page.screenshot(path=str(OUT / 'shots' / f'checkout-{width}.png'), full_page=True)
            if width == 1440:
                fresh, other, _ = new_page(1440, 1000)
                report.check(other.request.get(checkout_url).status == 404, 'страница оплаты без права в сессии — не 404')
                fresh.close()
        for problem in problems:
            report.check(False, f'{where}: {problem}')
        context.close()
    if stl:
        context, page, _ = new_page(1440, 1000)
        report.check(page.request.get(stl).status == 404, 'STL гостевого заказа без права в сессии — не 404')
        context.close()


def mailpit(method, path):
    with urlopen(Request(MAILPIT + path, method=method), timeout=5) as response:
        body = response.read().decode()
    return json.loads(body) if body.strip().startswith('{') else body


def check_password_reset(report, new_page, email, state):
    """Сброс по письму из Mailpit: ссылка → новый пароль; прежняя сессия клиента ведёт на вход. Возвращает новый пароль."""
    query = quote(f'to:"{email}"')
    mailpit('DELETE', f'/api/v1/search?query={query}')
    context, page, problems = new_page(1440, 1000)
    page.goto(BASE + '/en/account/reset', wait_until='networkidle')
    page.fill('#auth-form input[name=email]', email)
    with page.expect_navigation(wait_until='networkidle'):
        page.click('#auth-form button[type=submit]')
    report.check('If an account with this email exists' in page.locator('#auth-result').inner_text(), 'сброс: нет нейтрального ответа')

    messages = []
    for _ in range(50):
        messages = mailpit('GET', f'/api/v1/search?query={query}').get('messages', [])
        if messages:
            break
        time.sleep(0.1)
    if not report.check(len(messages) == 1, f'сброс: писем в Mailpit для клиента {len(messages)}, ожидалось 1'):
        context.close()
        return None
    message = mailpit('GET', f'/api/v1/message/{messages[0]["ID"]}')
    report.check(message.get('Subject') == 'Reset your password', f'сброс: тема письма «{message.get("Subject")}»')
    links = re.findall(r'href="([^"]+/en/account/reset/[^"]+)"', message.get('HTML', ''))
    if not report.check(len(links) == 1 and links[0].startswith(BASE), f'сброс: ссылка в письме {links}'):
        context.close()
        return None

    password = secrets.token_urlsafe(24)
    page.goto(html.unescape(links[0]), wait_until='networkidle')
    page.fill('#auth-form input[name=password]', password)
    with page.expect_navigation(wait_until='networkidle'):
        page.click('#auth-form button[type=submit]')
    report.check(urlparse(page.url).path == '/en/account/login', f'сброс: после смены пароля открылся {page.url}')
    report.check('Password changed' in page.locator('#auth-result').inner_text(), 'сброс: нет сообщения о смене пароля')
    for problem in problems:
        report.check(False, f'сброс: {problem}')
    context.close()

    # Прежняя сессия (вход до сброса) завершена: кабинет ведёт на вход.
    context, page, _ = new_page(1440, 1000, storage_state=state)
    page.goto(BASE + '/en/account', wait_until='networkidle')
    report.check(urlparse(page.url).path == '/en/account/login' and page.locator('#address-form').count() == 0,
                 f'сброс: прежняя сессия не завершена ({page.url})')
    context.close()
    return password


def mailpit_messages(query, expected=1):
    """Письма Mailpit по запросу поиска: ждёт expected писем до 5 с; возвращает полные сообщения."""
    messages = []
    for _ in range(50):
        messages = mailpit('GET', f'/api/v1/search?query={quote(query)}').get('messages', [])
        if len(messages) >= expected:
            break
        time.sleep(0.1)
    return [mailpit('GET', f'/api/v1/message/{message["ID"]}') for message in messages]


def check_form_mail(report, where, token, subject, client_email, expected_html):
    """Письмо о заявке — одно, на info@aiqme.com, без вложений, с данными формы; клиенту писем нет (W-09)."""
    messages = mailpit_messages(token)
    if not report.check(len(messages) == 1, f'{where}: писем в Mailpit с «{token}» {len(messages)}, ожидалось 1'):
        return
    message = messages[0]
    report.check([to['Address'] for to in message.get('To', [])] == ['info@aiqme.com'], f'{where}: адресаты письма {message.get("To")}')
    report.check(message.get('Subject') == subject, f'{where}: тема письма «{message.get("Subject")}»')
    report.check(not message.get('Attachments'), f'{where}: к письму приложены файлы')
    for text in expected_html:
        report.check(text in message.get('HTML', ''), f'{where}: в письме нет «{text}»')
    report.check(not mailpit_messages(f'to:"{client_email}"', expected=0), f'{where}: письмо ушло клиенту')


def check_contact_map(report, new_page, path, width, shots_dir):
    """Правка 28.10, П5: карта Google Maps (заглушка MAP_STUB) сразу видна под реквизитами, ссылка под ней в той же рамке."""
    where = f'{path} @{width} карта'
    locale = path.split('/')[1]
    stubbed = report.map_stubbed
    context, page, problems = new_page(width, 1000 if width == 1440 else 844)
    page.goto(BASE + path, wait_until='networkidle')
    iframes = page.locator('iframe')
    if report.check(iframes.count() == 1 and page.locator('.contact-map > iframe').count() == 1,
                    f'{where}: ожидался один iframe в .contact-map, найдено {iframes.count()}'):
        iframe = iframes.first
        report.check(iframe.is_visible(), f'{where}: iframe не виден')
        src = iframe.get_attribute('src') or ''
        report.check(MAP_EMBED.match(src) is not None and f'&hl={locale}&' in src, f'{where}: src {src}')
        report.check(bool((iframe.get_attribute('title') or '').strip()), f'{where}: нет title')
        report.check(iframe.get_attribute('loading') is None, f'{where}: есть loading')
        box = page.evaluate('''() => {
            const rect = (e) => e && e.getBoundingClientRect();
            const frame = document.querySelector('.contact-map');
            const [map, link, note] = [frame.querySelector('iframe'), frame.querySelector('a'), document.querySelector('.contact-map ~ .legal-note')];
            return {inner: frame.clientWidth, frame: rect(frame).toJSON(), map: rect(map).toJSON(),
                    link: link && rect(link).toJSON(), note: note && rect(note).toJSON()};
        }''')
        height = 320 if width == 1440 else 260
        report.check(abs(box['map']['width'] - box['inner']) <= 1, f'{where}: ширина карты {box["map"]["width"]} ≠ рамке {box["inner"]}')
        report.check(abs(box['map']['height'] - height) <= 1, f'{where}: высота карты {box["map"]["height"]} ≠ {height}')
        if report.check(box['link'] is not None, f'{where}: нет ссылки на карту'):
            report.check(box['map']['bottom'] <= box['link']['top'] + 1 and box['link']['top'] <= box['link']['bottom']
                         <= box['frame']['bottom'] + 1, f'{where}: ссылка не под картой внутри рамки {box}')
        if report.check(box['note'] is not None, f'{where}: нет .legal-note'):
            report.check(box['note']['top'] >= box['frame']['bottom'] - 1, f'{where}: .legal-note перекрыта рамкой карты {box}')
        loaded = [frame for frame in page.frames if MAP_EMBED.match(frame.url)]
        report.check(len(loaded) == 1 and loaded[0].locator('[data-map-stub]').count() == 1,
                     f'{where}: кадр карты не загружен (заглушка) {[frame.url for frame in page.frames]}')
        page.locator('[data-cookie-accept]').click()  # плашка не закрывает рамку на снимке
        page.locator('.contact-map').screenshot(path=str(shots_dir / f'contact-map-{locale}-{width}.png'))
    report.check(report.map_stubbed > stubbed, f'{where}: запрос карты не подменён заглушкой')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def wait_altcha(report, page, form, where):
    """Капча ALTCHA (П3): фокус в форме запускает решение (auto=onfocus); ждём скрытое поле altcha с решением и надпись
    «Verified»/«Patvirtinta» (≤ 30 с). Возвращает виджет."""
    widget = form.locator('altcha-widget')
    report.check(widget.count() == 1, f'{where}: виджетов капчи {widget.count()}')
    form.locator('input:visible').first.focus()
    try:
        page.wait_for_function('''(form) => {
            const input = form.querySelector('input[name=altcha]');
            const text = form.querySelector('altcha-widget')?.innerText || '';
            return input && input.value && /Verified|Patvirtinta/.test(text);
        }''', arg=form.element_handle(), timeout=30000)
    except PlaywrightTimeout:
        report.check(False, f'{where}: капча не решена за 30 с («{widget.inner_text().strip() if widget.count() else ""}»)')
    return widget


def altcha_shot(page, form, name, width):
    """Кадр формы с решённой капчей: shots/altcha-<страница>-<ширина>.png (плашка cookie и липкая шапка не закрывают)."""
    page.evaluate("document.querySelector('.cookie')?.remove(); document.querySelectorAll('.header').forEach((h) => h.style.visibility = 'hidden')")
    form.screenshot(path=str(OUT / 'shots' / f'altcha-{name}-{width}.png'))
    page.evaluate("document.querySelectorAll('.header').forEach((h) => h.style.visibility = '')")


def check_contact_form(report, new_page, path, width):
    """Контактная форма (W-09): заполнение, два вложения, отправка, сообщение в #contact-result, письмо AIQME в Mailpit."""
    where = f'{path} @{width} форма'
    token = 'bc' + secrets.token_hex(6)
    email = f'{token}@example.test'
    context, page, problems = new_page(width, 1000)
    page.goto(BASE + path, wait_until='networkidle')
    with tempfile.TemporaryDirectory() as directory:
        pdf = Path(directory) / 'drawing.pdf'
        pdf.write_bytes(b'%PDF-1.4\n%browser-check\n')
        stl = Path(directory) / 'part.stl'
        stl.write_text('solid part\nendsolid part\n')
        form = page.locator('#contact-form')
        form.locator('input[name=name]').fill(f'Ona {token}')
        form.locator('input[name=email]').fill(email)
        form.locator('select[name=service]').select_option('3d-printing')
        form.locator('textarea[name=description]').fill('Need ten brackets printed in PETG.')
        form.locator('input[type=file]').set_input_files([str(pdf), str(stl)])
        wait_altcha(report, page, form, where)
        altcha_shot(page, form, 'contact', width)
        with page.expect_navigation(wait_until='networkidle'):
            form.locator('button[type=submit]').click()
    result = page.locator('#contact-result').inner_text().strip()
    report.check(result == 'AIQME has received your enquiry. Files attached: 2.', f'{where}: результат «{result}»')
    report.check(urlparse(page.url).path == path, f'{where}: после отправки открылся {page.url}')
    check_form_mail(report, where, token, 'Nauja projekto užklausa', email, [f'Ona {token}', '3D printing', '<td>2</td>'])
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def calculator_files(directory):
    """Файлы проверки калькулятора во временном каталоге: ошибки формата и размера, крупные binary STL (~25 МБ)."""
    directory = Path(directory)
    cube = (STL_FIXTURES / 'cube-10mm-binary.stl').read_bytes()
    # 41 666 копий куба со сдвигом по X: ~500 000 треугольников и ~333 000 разных вершин, как у тяжёлой реальной модели.
    count = 500000 // 12
    template = [struct.unpack_from('<12fH', cube, 84 + i * 50) for i in range(12)]
    triangles = b''.join(struct.pack('<12fH', *t[:3], t[3] + dx, *t[4:6], t[6] + dx, *t[7:9], t[9] + dx, *t[10:12], 0)
                         for dx in range(0, count * 20, 20) for t in template)
    # Те же копии куба решёткой 35 × 35 × 35 (шаг 20 мм) — компактная модель для просмотра W-31.
    grid = b''.join(struct.pack('<12fH', *t[:3], t[3] + dx, t[4] + dy, t[5] + dz, t[6] + dx, t[7] + dy, t[8] + dz,
                                t[9] + dx, t[10] + dy, t[11] + dz, 0)
                    for dx, dy, dz in ((i % 35 * 20, i // 35 % 35 * 20, i // 1225 * 20) for i in range(count)) for t in template)
    files = {
        'bracket.step': b'ISO-10303-21;\n',
        'shell.obj': b'v 0 0 0\n',
        'photo.png': b'\x89PNG\r\n\x1a\n',
        'too-big.stl': b'\0' * (50 * 1024 * 1024 + 1),
        'large.stl': b'\0' * 80 + (count * 12).to_bytes(4, 'little') + triangles,
        'large-grid.stl': b'\0' * 80 + (count * 12).to_bytes(4, 'little') + grid,
    }
    for name, content in files.items():
        (directory / name).write_bytes(content)
    return {name: str(directory / name) for name in files}


def check_calculator(report, new_page, path, width, allowlist, files):
    """Калькулятор W-27: 5 шагов на кубе 10 мм (PLA, 100 %, qty 1 → 5,12), ошибки формата и лимитов, масштаб с
    подтверждением; шаг 2 по макету заказчика (правка 28.10, E-05): старых select нет, итог при «Reikia konsultacijos» =
    итогу при 20 %, пожелания и notes итог не меняют, заявка 201 уходит с новыми полями; кадры
    shots/calculator-step2-<ширина>.png и shots/calculator-step3-<ширина>.png (шаг 3 с габаритом 1000 мм); шаг 3 без флажка сценария (открытый тетраэдр — предупреждение, переход доступен), шаги 4 и сводка без
    VAT/доставки/скидки, поздний результат крупного файла и индикация разбора, ссылка специалиста. canvas отключён:
    расчёт не зависит от просмотра (W-31)."""
    en = path.startswith('/en')
    where = f'{path} @{width} калькулятор'
    context, page, problems = new_page(width, 1000)
    page.add_init_script('HTMLCanvasElement.prototype.getContext = () => null;')
    page.goto(BASE + path, wait_until='networkidle')
    error = page.locator('#quote-error')
    upload = page.locator('#model-upload')
    next_button = page.locator('[data-next]')

    def click(selector):
        # Кнопка по центру окна: липкая шапка и cookie-плашка не перекрывают её на 390.
        page.locator(selector).first.evaluate('(node) => node.scrollIntoView({block: "center"})')
        page.click(selector)

    def panel():
        return page.locator('[data-step-panel]:not([hidden])')

    def fits(step):
        scroll, client = document_fits(page)
        report.check(scroll <= client, f'{where}: шаг {step} шире окна ({scroll} > {client})')
        for hit in marker_hits(page, path, allowlist):
            report.check(False, f'{where}: шаг {step}: маркер {hit}')

    click('[data-next]')
    report.check(error.inner_text().strip() == ('Upload a model.' if en else 'Įkelkite modelį.'), f'{where}: без файла — «{error.inner_text()}»')

    # Ошибки формата и лимитов: OBJ/STEP — к специалисту со ссылкой на контакты, иное — отказ, моделей нет.
    upload.set_input_files([files['bracket.step'], files['shell.obj'], files['photo.png'], files['too-big.stl'],
                            str(STL_FIXTURES / 'truncated-binary.stl')])
    page.wait_for_function("document.querySelector('#quote-error').innerText.includes('truncated')")
    text = error.inner_text()
    expected = (['bracket.step: specialist review required.', 'shell.obj: specialist review required.',
                 'photo.png: unsupported format', 'too-big.stl: File exceeds the 50 MB limit', 'truncated-binary.stl: Could not read geometry']
                if en else ['bracket.step: reikalinga specialisto peržiūra.', 'photo.png: nepalaikomas formatas',
                            'too-big.stl: Failas viršija 50 MB ribą', 'truncated-binary.stl: Geometrijos nuskaityti nepavyko'])
    for phrase in expected:
        report.check(phrase in text, f'{where}: нет ошибки «{phrase}» в «{text}»')
    contact = error.locator('a[data-specialist]').get_attribute('href') or ''
    report.check('/contact?' in contact or '/kontaktai?' in contact, f'{where}: ссылка специалиста в ошибке «{contact}»')
    report.check('bracket.step' in contact, f'{where}: OBJ/STEP не попали в message ссылки')
    report.check(page.locator('[data-files] .file-row').count() == 0, f'{where}: после ошибок появились модели')

    # Куб 10 мм; масштаб: неверный — ошибка без окна, 200 % — окно «было/будет», подтверждение, затем обратно 100 %.
    upload.set_input_files(str(STL_FIXTURES / 'cube-10mm-binary.stl'))
    page.wait_for_selector('[data-model]:not([hidden])')
    row = page.locator('[data-files] .file-row').inner_text()
    report.check(('Geometry ready to view · STL' if en else 'Geometrija paruošta peržiūrai · STL') in row, f'{where}: строка файла «{row}»')
    dims = page.locator('[data-dimensions]')
    report.check(dims.inner_text() == '10.0 × 10.0 × 10.0 mm', f'{where}: габарит «{dims.inner_text()}»')
    page.fill('#model-scale', '0')
    click('[data-apply-scale]')
    report.check(page.locator('#scale-confirm').is_hidden(), f'{where}: окно масштаба открылось при 0 %')
    report.check(('between 1 and 1000' if en else 'nuo 1 iki 1000') in error.inner_text(), f'{where}: нет ошибки масштаба')
    page.fill('#model-scale', '200')
    click('[data-apply-scale]')
    modal = page.locator('#scale-confirm')
    report.check(modal.is_visible(), f'{where}: окно подтверждения масштаба не открылось')
    modal_text = modal.inner_text()
    report.check('10.0 × 10.0 × 10.0 mm' in modal_text and '20.0 × 20.0 × 20.0 mm' in modal_text, f'{where}: окно масштаба «{modal_text}»')
    click('[data-scale-confirm]')
    report.check(modal.is_hidden() and dims.inner_text() == '20.0 × 20.0 × 20.0 mm', f'{where}: масштаб не применён «{dims.inner_text()}»')
    page.select_option('#model-unit', 'mm')
    page.fill('#model-scale', '100')
    click('[data-apply-scale]')
    click('[data-scale-confirm]')
    report.check(dims.inner_text() == '10.0 × 10.0 × 10.0 mm', f'{where}: масштаб 100 % не вернулся')
    fits(1)

    # Шаг 2 по макету заказчика (правка 28.10, E-05): старых select нет; сумму меняют только материал и заполнение —
    # «Reikia konsultacijos» = заполнение 20 % по умолчанию, пожелания и notes data-cents не меняют; затем PLA, 100 %, количество 1.
    click('[data-next]')
    report.check(page.locator('[data-step-panel="1"]').is_visible(), f'{where}: шаг 2 не открылся')
    report.check(page.locator('.tech-choices, [data-action=technology]').count() == 0, f'{where}: на шаге 2 есть кнопки технологии')
    for technology in ('SLA', 'SLS', 'Metal'):
        report.check(not re.search(rf'\b{technology}\b', panel().inner_text()), f'{where}: на шаге 2 есть «{technology}»')
    report.check(page.locator('select[name=quality], select[name=layer], select[name=finish]').count() == 0, f'{where}: на шаге 2 старые select')
    # Правка 30.10 (Г3, F-03): подпись «… (neprivaloma)», по умолчанию выбран none — «Nepasirinkta» / «Not selected».
    service_label = page.locator('label:has(select[name=service])').evaluate('(label) => label.firstChild.textContent.trim()')
    report.check(service_label == ('Additional services (optional)' if en else 'Papildomos paslaugos (neprivaloma)'), f'{where}: подпись услуг «{service_label}»')
    service_default = page.locator('select[name=service]').evaluate('(select) => [select.value, select.selectedOptions[0].textContent.trim()]')
    report.check(service_default == ['none', 'Not selected' if en else 'Nepasirinkta'], f'{where}: услуга по умолчанию {service_default}')
    page.select_option('select[name=material]', 'PLA')
    cents = lambda: int(page.locator('[data-total]').get_attribute('data-cents') or -1)
    page.select_option('select[name=infill]', '20')
    at20 = cents()
    page.select_option('select[name=infill]', 'consult')
    report.check(cents() == at20 > 0, f'{where}: итог при консультации {cents()} ≠ итогу при 20 % {at20}')
    for name, value in (('purpose', 'practical'), ('service', 'inserts'), ('surface', 'high'), ('term', 'priority')):
        page.select_option(f'select[name={name}]', value)
        report.check(cents() == at20, f'{where}: {name}={value} изменил итог ({cents()} ≠ {at20})')
    page.fill('textarea[name=notes]', 'Pagaminti iki penktadienio.\nDetales supakuoti atskirai.')
    page.locator('textarea[name=notes]').dispatch_event('change')
    report.check(cents() == at20, f'{where}: notes изменил итог ({cents()} ≠ {at20})')
    # Кадр панели без плашки cookie и липкой шапки поверх (шапка возвращается сразу после кадра).
    page.locator('[data-cookie-accept]').click()
    page.evaluate("document.querySelector('header.header').style.visibility = 'hidden'")
    page.locator('[data-step-panel="1"]').screenshot(path=str(OUT / 'shots' / f'calculator-step2-{width}.png'))
    page.evaluate("document.querySelector('header.header').style.visibility = ''")
    page.select_option('select[name=infill]', '100')
    report.check(cents() == 512, f'{where}: итог при 100 % {cents()}, а не 512')
    report.check(page.locator('[data-quantity]').input_value() == '1', f'{where}: количество не 1')
    fits(2)

    # Шаг 3: флажка сценария нет, предупреждений у замкнутого куба нет; габарит FDM 1000 мм (П7).
    click('[data-next]')
    report.check(page.locator('#simulate-risk, [data-step-panel="2"] input[type=checkbox]').count() == 0, f'{where}: на шаге 3 есть флажок')
    report.check(page.locator('[data-warnings]').is_hidden(), f'{where}: у куба есть предупреждения')
    report.check('FDM: 1000 × 1000 × 1000 mm.' in panel().inner_text(), f'{where}: на шаге 3 нет строки габарита 1000 мм')
    label = next_button.inner_text().strip()
    report.check(label == ('Continue' if en else 'Tęsti'), f'{where}: кнопка шага 3 «{label}»')
    page.locator('[data-step-panel="2"]').screenshot(path=str(OUT / 'shots' / f'calculator-step3-{width}.png'))
    fits(3)

    # Шаг 4: столбцы, строка 0,12, итог 5,12 = сумма строк сводки, без VAT/доставки/скидки.
    click('[data-next]')
    headers = page.locator('[data-step-panel="3"] th').all_inner_texts()
    report.check(headers == (['Part', 'Quantity', 'Estimate'] if en else ['Detalė', 'Kiekis', 'Sąmata']), f'{where}: столбцы {headers}')
    cells = page.locator('[data-price-rows] td').all_inner_texts()
    line = '€0.12' if en else '0,12 €'
    report.check(len(cells) == 3 and cells[1] == '1' and cells[2] == line, f'{where}: строка шага 4 {cells}')
    total = page.locator('[data-total]')
    expected_total = '€5.12' if en else '5,12 €'
    report.check(total.inner_text() == expected_total, f'{where}: итог «{total.inner_text()}» вместо «{expected_total}»')
    rows = [int(c) for c in page.locator('[data-summary-rows] [data-cents]').evaluate_all('(nodes) => nodes.map((n) => n.dataset.cents)')]
    report.check(sum(rows) == int(total.get_attribute('data-cents')) == 512, f'{where}: строки сводки {rows} ≠ итог')
    labels = page.locator('[data-summary-rows] .summary-row span').all_inner_texts()
    report.check(labels == ['cube-10mm-binary.stl × 1', 'Order fee' if en else 'Užsakymo mokestis'], f'{where}: строки сводки {labels}')
    label = next_button.inner_text().strip()
    report.check(label == ('Proceed to checkout' if en else 'Pereiti prie užsakymo'), f'{where}: кнопка шага 4 «{label}»')
    shown = (page.locator('[data-step-panel="3"]').inner_text() + '\n' + page.locator('.quote-summary').inner_text()).lower()
    for phrase in ('vat', 'pvm', 'delivery (', 'pristatymas (', 'shipping', 'discount', 'nuolaida', 'unit', 'vnt.'):
        report.check(phrase not in shown, f'{where}: в шаге 4 или сводке есть «{phrase}»')
    fits(4)

    # Шаг 5: поле VAT-кода есть, кнопок шагов нет; адрес скрыт при самовывозе.
    click('[data-next]')
    report.check(page.locator('#checkout-form').is_visible(), f'{where}: шаг 5 не открылся')
    report.check(page.locator('#checkout-form input[name=vat_code]').is_visible(), f'{where}: нет поля VAT-кода')
    report.check(page.locator('[data-actions]').is_hidden(), f'{where}: на шаге 5 видны кнопки шагов')
    page.select_option('select[name=delivery]', 'pickup')
    report.check(page.locator('[data-address]').is_hidden(), f'{where}: адрес виден при самовывозе')
    fits(5)
    href = page.locator('.help-box a[data-specialist]').get_attribute('href')

    # Заявка W-12 (canvas отключён): пустая форма — ошибки сервера под полями, заказа нет; заполненная — подтверждение.
    submit = page.locator('#checkout-form button[type=submit]')
    report.check(submit.is_enabled(), f'{where}: отправка недоступна')
    with page.expect_response(lambda response: response.request.method == 'POST') as answer:
        click('#checkout-form button[type=submit]')
    report.check(answer.value.status == 422, f'{where}: пустая форма — ответ {answer.value.status}, а не 422')
    page.wait_for_selector('#checkout-form small[data-error]')
    problems[:] = [problem for problem in problems if problem != f'422 {BASE}{path}']  # ожидаемый ответ проверки
    required = 'Fill in this field.' if en else 'Užpildykite šį lauką.'
    for name in ('name', 'email', 'phone'):
        field = page.locator(f'#checkout-form [name={name}]')
        error = field.locator('xpath=..').locator('small[data-error]')
        report.check(field.get_attribute('aria-invalid') == 'true' and error.count() == 1 and error.inner_text() == required,
                     f'{where}: нет ошибки под полем {name}')
    report.check(page.locator('#checkout-form small[data-error]').count() == 3, f'{where}: лишние ошибки полей при самовывозе')
    shown_cents = int(page.locator('[data-total]').get_attribute('data-cents'))
    page.fill('#checkout-form [name=name]', 'Ona Petraitė')
    page.fill('#checkout-form [name=email]', 'ona@example.test')
    page.fill('#checkout-form [name=phone]', '+370 600 00000')
    with page.expect_response(lambda response: response.request.method == 'POST', timeout=30000) as answer:
        click('#checkout-form button[type=submit]')
    body = answer.value.request.post_data_buffer or b''
    sent_fields = {name: re.search(rb'name="' + name.encode() + rb'"\r\n\r\n([^\r]*(?:\r\n(?!--)[^\r]*)*)\r\n--', body) for name in
                   ('infill', 'purpose', 'service', 'surface', 'term', 'notes')}
    sent_fields = {name: match.group(1).decode().replace('\r\n', '\n') if match else None for name, match in sent_fields.items()}
    report.check(answer.value.status == 201 and sent_fields == {'infill': '100', 'purpose': 'practical', 'service': 'inserts', 'surface': 'high',
                 'term': 'priority', 'notes': 'Pagaminti iki penktadienio.\nDetales supakuoti atskirai.'},
                 f'{where}: заявка {answer.value.status} с полями {sent_fields}')
    page.wait_for_url('**/' + ('quote/submitted' if en else 'kalkuliatorius/pateikta'), timeout=30000)
    page.wait_for_load_state('networkidle')
    number = page.locator('[data-order-number]').get_attribute('data-order-number') or ''
    confirmed_cents = int(page.locator('[data-total]').get_attribute('data-cents') or -1)
    report.check(number.isdigit(), f'{where}: на подтверждении нет номера заказа')
    report.check(confirmed_cents == shown_cents == 512, f'{where}: сумма подтверждения {confirmed_cents}, на экране калькулятора {shown_cents}')
    sent = 'AIQME has received your order No. ' if en else 'AIQME gavo jūsų užsakymą Nr. '
    report.check(sent + number in page.locator('.notice.success').inner_text(), f'{where}: нет текста подтверждения с номером')
    guest = page.locator('a[data-guest-link]').get_attribute('href') or ''
    report.check(guest.startswith(BASE + ('/en/order/' if en else '/lt/uzsakymas/') + number + '/'), f'{where}: гостевая ссылка «{guest}»')
    fits('подтверждение')
    page.goto(guest, wait_until='networkidle')
    title = page.locator('h1').inner_text()
    report.check(title == ('Order progress' if en else 'Užsakymo eiga'), f'{where}: гостевая страница «{title}»')
    heading = page.locator('#customer-order h2').inner_text()
    report.check(heading == (f'Order No. {number}' if en else f'Užsakymas Nr. {number}'), f'{where}: номер на гостевой странице «{heading}»')
    report.check('cube-10mm-binary.stl' in page.locator('[data-order-number]').inner_text(), f'{where}: на гостевой странице нет файла')
    fits('гостевая страница')
    wrong = page.goto(guest[:-4] + 'AAAA', wait_until='networkidle')
    report.check(wrong.status == 404, f'{where}: гостевая ссылка с чужим токеном — {wrong.status}')

    # Ссылка специалиста: контактная форма с услугой печати и описанием модели и параметров.
    page.goto(href, wait_until='networkidle')
    description = page.locator('textarea[name=description]').input_value()
    report.check(description.startswith('Please help review these files:' if en else 'Prašau padėti įvertinti failus:')
                 and 'cube-10mm-binary.stl: 10.0 × 10.0 × 10.0 mm' in description and 'FDM / PLA' in description,
                 f'{where}: описание в контактной форме «{description[:200]}»')
    report.check(page.locator('select[name=service]').input_value() == ('3d-printing' if en else '3d-spausdinimas'), f'{where}: услуга не печать')

    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()

    # Открытый тетраэдр: предупреждение «незамкнутая сетка» на шаге 3, переход дальше доступен.
    context, page, problems = new_page(width, 1000)
    page.goto(BASE + path, wait_until='networkidle')
    page.locator('#model-upload').set_input_files(str(STL_FIXTURES / 'tetrahedron-open-ascii.stl'))
    page.wait_for_selector('[data-model]:not([hidden])')
    click('[data-next]')
    click('[data-next]')
    warning = page.locator('[data-warning-list]')
    report.check(warning.is_visible() and ('not closed' if en else 'neuždaras') in warning.inner_text(), f'{where}: нет предупреждения об открытой сетке')
    click('[data-next]')
    report.check(page.locator('[data-step-panel="3"]').is_visible(), f'{where}: предупреждение заблокировало переход')
    for problem in problems:
        report.check(False, f'{where} (тетраэдр): {problem}')
    context.close()

    # Крупный файл (~25 МБ, разбор в Web Worker) и сразу куб: индикация, страница не замирает, на экране — куб.
    context, page, problems = new_page(width, 1000)
    page.goto(BASE + path, wait_until='networkidle')
    page.evaluate("""() => { window.gaps = []; let last = performance.now();
        window.ticker = setInterval(() => { const now = performance.now(); window.gaps.push(now - last); last = now; }, 20); }""")
    page.locator('#model-upload').set_input_files(files['large.stl'])
    try:
        page.wait_for_selector('#upload-progress progress', timeout=5000)
    except Exception:
        report.check(False, f'{where}: нет индикации разбора крупного файла')
    page.locator('#model-upload').set_input_files(str(STL_FIXTURES / 'cube-10mm-ascii.stl'))
    page.wait_for_function("document.querySelectorAll('[data-files] .file-row').length === 2 && !document.querySelector('#upload-progress progress')", timeout=60000)
    gap = page.evaluate('() => { clearInterval(window.ticker); return Math.max(...window.gaps); }')
    report.check(gap < 400, f'{where}: страница замирала на {gap:.0f} мс при разборе крупного файла')
    active = page.locator('[data-files] .file-row.active').inner_text()
    report.check('cube-10mm-ascii.stl' in active and page.locator('[data-dimensions]').inner_text() == '10.0 × 10.0 × 10.0 mm',
                 f'{where}: после позднего разбора крупного файла активна «{active}»')
    for problem in problems:
        report.check(False, f'{where} (крупный файл): {problem}')
    context.close()


def check_viewer(report, new_page, path, width, files):
    """Просмотр модели W-31 (Canvas 2D): на кубе из tests/fixtures/stl/ на canvas есть пиксели модели (не только фон и сетка),
    ArrowRight, «+», кнопка масштаба, колесо и перетаскивание меняют toDataURL, сброс возвращает исходный снимок; модель
    500 000 треугольников (во временном каталоге) рисуется прореженной — время кадра в заметках отчёта."""
    where = f'{path} @{width} просмотр'
    context, page, problems = new_page(width, 1000)
    page.goto(BASE + path, wait_until='networkidle')
    canvas = page.locator('#model-canvas')
    page.locator('#model-upload').set_input_files(str(STL_FIXTURES / 'cube-10mm-binary.stl'))
    page.wait_for_selector('[data-model]:not([hidden])')
    canvas.evaluate('(node) => node.scrollIntoView({block: "center"})')
    # Пиксели модели: заливка граней rgb(15·s, 105·s, 245·s) непрозрачна; сетка — полупрозрачная серо-голубая.
    model_pixels = """(canvas) => { const d = canvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height).data;
        let n = 0; for (let i = 0; i < d.length; i += 4) if (d[i + 3] === 255 && d[i] < 20 && d[i + 2] > 120) n++; return n; }"""
    pixels = canvas.evaluate(model_pixels)
    report.check(pixels > 1000, f'{where}: на canvas нет пикселей модели ({pixels})')
    snapshot = lambda: canvas.evaluate('(node) => node.toDataURL()')
    initial = snapshot()
    canvas.focus()
    page.keyboard.press('ArrowRight')
    report.check(snapshot() != initial, f'{where}: ArrowRight не изменил изображение')
    def box():
        canvas.evaluate('(node) => node.scrollIntoView({block: "center"})')
        return canvas.bounding_box()

    # Сброс — тоже с холстом по центру: после колеса/перетаскивания кнопку у верхнего края холста перекрывала липкая шапка.
    reset = lambda: (box(), page.locator('[data-reset-view]').click())
    reset()
    report.check(snapshot() == initial, f'{where}: после сброса изображение не совпало с исходным')

    def wheel(delta):
        b = box()
        page.mouse.move(b['x'] + b['width'] / 2, b['y'] + b['height'] / 2)
        page.mouse.wheel(0, delta)

    def drag():
        b = box()
        page.mouse.move(b['x'] + 100, b['y'] + 100)
        page.mouse.down()
        page.mouse.move(b['x'] + 160, b['y'] + 130)
        page.mouse.up()

    for action, name in ((lambda: (canvas.focus(), page.keyboard.press('+')), 'клавиша +'),
                         # Холст по центру: иначе кнопки у верхнего края перекрывает липкая шапка (нестабильно, E-03/E-04).
                         (lambda: (box(), page.locator('[data-zoom-in]').click()), 'кнопка +'),
                         (lambda: (box(), page.locator('[data-zoom-out]').click()), 'кнопка −'),
                         (lambda: wheel(100), 'колесо'), (drag, 'перетаскивание')):
        action()
        report.check(snapshot() != initial, f'{where}: {name} не изменил изображение')
        reset()
        report.check(snapshot() == initial, f'{where}: после «{name}» сброс не вернул исходное изображение')
    box()
    scroll = page.evaluate('window.scrollY')
    wheel(300)
    page.wait_for_timeout(300)
    # Без preventDefault колесо на 300 сдвинуло бы страницу на сотни px; на 390 положение дрожит на 2–3 px (раскладка).
    moved = abs(page.evaluate('window.scrollY') - scroll)
    report.check(moved < 50, f'{where}: колесо над canvas прокрутило страницу на {moved} px')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()

    # Модель предельного размера: рисуется прореженной; кадр — синхронная перерисовка по ArrowRight.
    context, page, problems = new_page(width, 1000)
    page.goto(BASE + path, wait_until='networkidle')
    page.locator('#model-upload').set_input_files(files['large-grid.stl'])
    page.wait_for_selector('[data-model]:not([hidden])', timeout=60000)
    canvas = page.locator('#model-canvas')
    canvas.evaluate('(node) => node.scrollIntoView({block: "center"})')
    frames = canvas.evaluate("""(node) => Array.from({ length: 10 }, () => { const start = performance.now();
        node.dispatchEvent(new KeyboardEvent('keydown', { key: 'ArrowRight' })); return performance.now() - start; })""")
    pixels = canvas.evaluate(model_pixels)
    report.check(pixels > 100, f'{where}: модель 500 000 треугольников не нарисована ({pixels})')
    worst = max(frames)
    report.check(worst < 100, f'{where}: кадр модели 500 000 треугольников {worst:.0f} мс (≥ 100)')
    note = f'W-31 {path} @{width}: кадр 500 000 треугольников — медиана {sorted(frames)[5]:.1f} мс, максимум {worst:.1f} мс'
    report.notes.append(note)
    log(f'   {note}')
    for problem in problems:
        report.check(False, f'{where} (крупная модель): {problem}')
    context.close()


def check_training_modal(report, new_page, path, width):
    """Модалка регистрации на обучение (W-09): кнопка темы, Escape и возврат фокуса, отправка, подтверждение, письмо."""
    where = f'{path} @{width} регистрация'
    token = 'bt' + secrets.token_hex(6)
    email = f'{token}@example.test'
    context, page, problems = new_page(width, 900)
    page.goto(BASE + path, wait_until='networkidle')
    button = page.locator('a[data-training="cad-basics"]')
    modal_id = button.get_attribute('data-modal-open') or ''
    modal = page.locator(f'#{modal_id}')
    button.click()
    report.check(modal.is_visible() and urlparse(page.url).path == path, f'{where}: окно не открылось или ушли со страницы')
    report.check(page.evaluate(f"document.getElementById('{modal_id}').contains(document.activeElement)"), f'{where}: фокус не в окне')
    report.check(modal.locator('select[name=format] option').all_inner_texts() == ['Online', 'At AIQME'], f'{where}: варианты участия')
    page.keyboard.press('Escape')
    report.check(not modal.is_visible(), f'{where}: Escape не закрыл окно')
    report.check(page.evaluate(f"document.activeElement.matches('[data-modal-open=\"{modal_id}\"]')"), f'{where}: фокус не вернулся на кнопку')

    button.click()
    modal.locator('input[name=name]').fill(f'Jonas {token}')
    modal.locator('input[name=email]').fill(email)
    modal.locator('select[name=format]').select_option('aiqme')
    modal.locator('input[name=participants]').fill('3')
    form = modal.locator('form')
    wait_altcha(report, page, form, where)
    altcha_shot(page, modal.locator('[role=dialog]'), 'training', width)
    with page.expect_navigation(wait_until='networkidle'):
        modal.locator('button[type=submit]').click()
    confirmation = page.locator('#training-confirmation')
    report.check(urlparse(page.url).path == path, f'{where}: после отправки открылся {page.url}')
    report.check(confirmation.is_visible(), f'{where}: окно подтверждения не открылось')
    text = confirmation.locator('[role=status]').inner_text().strip() if confirmation.count() else ''
    report.check(text == 'AIQME has received your registration.', f'{where}: подтверждение «{text}»')
    scroll, client = document_fits(page)
    report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
    page.keyboard.press('Escape')
    report.check(not confirmation.is_visible(), f'{where}: Escape не закрыл подтверждение')
    report.check(page.evaluate(f"document.activeElement.matches('[data-modal-open=\"{modal_id}\"]')"), f'{where}: фокус не на кнопке темы')
    check_form_mail(report, where, token, 'Mokymų registracija', email, [f'Jonas {token}', 'CAD basics', 'AIQME patalpose', '<td>3</td>'])
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def check_register(report, new_page, path, width):
    """Регистрация кабинета с капчей ALTCHA (П3): «Patvirtinta», кадр формы, отправка открывает кабинет с #account-overview."""
    where = f'{path} @{width} регистрация кабинета'
    token = 'br' + secrets.token_hex(6)
    context, page, problems = new_page(width, 844)
    page.goto(BASE + path, wait_until='networkidle')
    form = page.locator('#auth-form[data-mode=register]')
    form.locator('input[name=name]').fill(f'Rūta {token}')
    form.locator('input[name=email]').fill(f'{token}@example.test')
    form.locator('input[name=password]').fill(secrets.token_urlsafe(12))
    widget = wait_altcha(report, page, form, where)
    report.check('Patvirtinta' in widget.inner_text(), f'{where}: надпись виджета «{widget.inner_text().strip()}»')
    altcha_shot(page, form, 'register', width)
    with page.expect_navigation(wait_until='networkidle'):
        form.locator('button[type=submit]').click()
    report.check(urlparse(page.url).path == '/lt/paskyra', f'{where}: после отправки открылся {page.url}')
    report.check(page.locator('#account-overview').count() == 1, f'{where}: нет #account-overview')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def check_accounts(report, new_page, accounts, ru_paths, allowlist):
    admin_email, admin_password = accounts['admin']
    client_email, client_password = accounts['client']
    log('== вход через форму: администратор и клиент')
    admin = sign_in(report, new_page, '/en/account/login', admin_email, admin_password, '/en/admin')
    client = sign_in(report, new_page, '/lt/paskyra/login', client_email, client_password, '/lt/paskyra')
    check_private_pages(report, new_page, ACCOUNT_PAGES, client, '.account-layout', allowlist, 'клиент')
    log('== кабинет: карточка, ответ, пересчитать и повторный заказ; гостевая страница (W-15)')
    check_customer_orders(report, new_page, client, accounts['guest_url'], allowlist)
    check_private_pages(report, new_page, ADMIN_PAGES, admin, 'main h1', allowlist, 'администратор')
    check_header(report, new_page, '/en/admin', 1440, state=admin)
    log('== редактор контента админки (W-08)')
    check_admin_editor(report, new_page, admin)
    log('== редакторы W-26')
    check_admin_editors_w26(report, new_page, admin)
    log('== настройки калькулятора (W-11)')
    check_calculator_settings(report, new_page, admin)
    log('== карточка заказа (W-14)')
    check_admin_order(report, new_page, admin, allowlist)
    check_status(report, new_page, ADMIN_PAGES + ru_paths[:3], client, 404, 'клиент')
    check_status(report, new_page, ADMIN_PAGES + ru_paths[:3], None, 404, 'гость')
    check_russian(report, new_page, ru_paths, admin)
    check_profile_and_logout(report, new_page, client)
    log('== сброс пароля по письму (Mailpit)')
    client = sign_in(report, new_page, '/lt/paskyra/login', client_email, client_password, '/lt/paskyra')
    new_password = check_password_reset(report, new_page, client_email, client)
    if new_password:
        sign_in(report, new_page, '/en/account/login', client_email, new_password, '/en/account')


def evidence_shot(path, device):
    """Кадр эталона для пути (по verified-route-screens.json); None — эталона нет."""
    index = EVIDENCE / 'verified-route-screens.json'
    if not index.exists():
        return None
    prototype_path = path.rstrip('/') + '/'
    for entry in json.loads(index.read_text()):
        if entry['path'] == prototype_path and entry['device'] == device:
            shot = EVIDENCE / entry['file']
            return shot if shot.exists() else None
    return None


# ---------- W-20: сценарий в локальном prod-compose (--base-url … --compose-file docker-compose.prod.yml) ----------

PROD_ENV = APP / 'build' / 'prod-local' / '.env'
PROD_COMPOSE = APP / 'docker-compose.prod.yml'
PROD_PROJECT = 'aiqme-prod'
PHP_SERVICES = ('app', 'worker', 'scheduler')


def env_values(file):
    values = {}
    for line in file.read_text(encoding='utf-8').splitlines():
        if '=' in line and not line.lstrip().startswith('#'):
            key, value = line.split('=', 1)
            values[key.strip()] = value.strip().strip('"')
    return values


def prod_target(argv):
    """Разбор и проверка цели режима prod-compose — до любых действий (Docker, БД, браузер): только 127.0.0.1/localhost,
    только docker-compose.prod.yml проекта aiqme-prod и build/prod-local/.env (AIQME_ENV_FILE, порт web). Иначе — отказ."""
    def refuse(reason):
        sys.exit(f'FAIL: режим --base-url отказан до любых действий: {reason}')

    options = {}
    rest = list(argv)
    while rest:
        name = rest.pop(0)
        if name not in ('--base-url', '--compose-file') or not rest or name in options:
            refuse(f'ожидается ровно --base-url <адрес> --compose-file docker-compose.prod.yml, получено {" ".join(argv)}')
        options[name] = rest.pop(0)
    if set(options) != {'--base-url', '--compose-file'}:
        refuse('нужны оба параметра: --base-url и --compose-file')
    url = urlparse(options['--base-url'])
    if url.scheme != 'http' or url.hostname not in ('127.0.0.1', 'localhost') or url.path not in ('', '/') or url.query:
        refuse(f'адрес {options["--base-url"]} — только http://127.0.0.1:<порт> или http://localhost:<порт>')
    compose = (APP / options['--compose-file']).resolve()
    if compose != PROD_COMPOSE or not compose.is_file():
        refuse(f'compose-файл {options["--compose-file"]} — только docker-compose.prod.yml')
    if not re.search(rf'^name:\s*{PROD_PROJECT}\s*$', compose.read_text(encoding='utf-8'), re.M):
        refuse(f'в docker-compose.prod.yml нет name: {PROD_PROJECT}')
    if not PROD_ENV.is_file():
        refuse('нет build/prod-local/.env')
    values = env_values(PROD_ENV)
    if values.get('AIQME_ENV_FILE') != 'build/prod-local/.env':
        refuse('в build/prod-local/.env AIQME_ENV_FILE не build/prod-local/.env')
    if url.port is None or str(url.port) != values.get('AIQME_WEB_PORT'):
        refuse(f'порт {url.port} не совпадает с AIQME_WEB_PORT={values.get("AIQME_WEB_PORT")} в build/prod-local/.env')
    return f'http://{url.hostname}:{url.port}', values


def compose_cmd(*args):
    return ['docker', 'compose', '--env-file', 'build/prod-local/.env', '-f', 'docker-compose.prod.yml', *args]


def artisan(*args, stdin=None):
    return run(compose_cmd('exec', '-T', '-u', 'www-data', 'app', 'php', 'artisan', *args), stdin=stdin)


def check_prod_compose(report):
    """docker compose config: порты только у web и только 127.0.0.1; .env — только для чтения во всех PHP-сервисах,
    без env_file; worker — один процесс с очередью sheets; лимиты ресурсов и ротация журналов у всех сервисов."""
    services = json.loads(run(compose_cmd('config', '--format', 'json')).stdout)['services']
    for name, service in services.items():
        ports = service.get('ports', [])
        if name == 'web':
            report.check(ports and all(port.get('host_ip') == '127.0.0.1' for port in ports), f'compose: порты web {ports}')
        else:
            report.check(not ports, f'compose: у {name} есть ports {ports}')
        limits = service.get('deploy', {}).get('resources', {}).get('limits', {})
        report.check(bool(limits.get('memory')) and bool(limits.get('cpus')), f'compose: у {name} нет deploy.resources.limits')
        options = service.get('logging', {}).get('options', {})
        report.check(bool(options.get('max-size')) and bool(options.get('max-file')), f'compose: у {name} нет ротации журналов')
        report.check('env_file' not in service, f'compose: у {name} env_file')
    for name in PHP_SERVICES:
        mounts = [v for v in services[name].get('volumes', []) if v.get('target') == '/var/www/html/.env']
        report.check(len(mounts) == 1 and mounts[0].get('read_only') and mounts[0].get('source') == str(PROD_ENV),
                     f'compose: .env в {name} {mounts}')
    for name in ('worker', 'scheduler'):
        report.check(services[name].get('user') == 'www-data', f'compose: {name} не от www-data')
    command = ' '.join(services['worker'].get('command') or [])
    report.check('queue:work' in command and 'sheets' in command and services['worker'].get('deploy', {}).get('replicas', 1) == 1,
                 f'compose: worker {command}')
    return services


def check_prod_image(report, services):
    """Образ app: расширения §2.1, gd с JPEG/WebP/FreeType, лимиты §6.4, нет лишних файлов; web: curl для healthcheck."""
    image, web_image = services['app']['image'], services['web']['image']
    modules = run(['docker', 'run', '--rm', image, 'php', '-m']).stdout.split()
    for extension in ('bcmath', 'intl', 'gd', 'pdo_pgsql', 'pgsql', 'zip', 'exif', 'OPcache'):
        report.check(extension in modules, f'образ: нет расширения {extension}')
    gd = run(['docker', 'run', '--rm', image, 'php', '-r',
              'echo json_encode(array_intersect_key(gd_info(), array_flip(["JPEG Support", "WebP Support", "FreeType Support"])));']).stdout
    report.check(json.loads(gd) == {'JPEG Support': True, 'WebP Support': True, 'FreeType Support': True}, f'образ: gd_info {gd}')
    info = run(['docker', 'run', '--rm', image, 'php', '-i']).stdout
    for key, value in (('upload_max_filesize', '50M'), ('post_max_size', '510M'), ('max_file_uploads', '20'), ('memory_limit', '768M')):
        report.check(re.search(rf'^{key} => {value} => {value}$', info, re.M) is not None, f'образ: php -i {key} не {value}')
    fpm = run(['docker', 'run', '--rm', image, 'php-fpm', '-i']).stdout
    report.check(re.search(r'^max_execution_time => 120 => 120$', fpm, re.M) is not None, 'образ: PHP-FPM max_execution_time не 120')
    fpm_config = run(['docker', 'run', '--rm', image, 'php-fpm', '-tt']).stderr
    report.check(re.search(r'clear_env = yes', fpm_config) is not None, 'образ: PHP-FPM без clear_env = yes')
    found = run(['docker', 'run', '--rm', image, 'find', '/var/www/html', '-path', '/var/www/html/vendor', '-prune', '-o',
                 '(', '-name', '.env', '-o', '-name', 'experiments', '-o', '-name', 'instance', '-o', '-path', '*/tests/fixtures',
                 '-o', '-path', '/var/www/html/bootstrap/cache/config.php', ')', '-print']).stdout.split()
    report.check(found == [], f'образ: лишние файлы {found}')
    link = run(['docker', 'run', '--rm', image, 'readlink', '/var/www/html/public/storage']).stdout.strip()
    report.check(link == '../storage/app/public', f'образ: public/storage → {link}')
    tools = run(['docker', 'run', '--rm', web_image, 'sh', '-c', 'command -v curl || true']).stdout.strip()
    report.check(tools != '', 'образ web: нет curl для healthcheck')


def check_prod_runtime(report, values):
    """web — healthy; доверенный прокси после optimize — шлюз сети проекта; APP_ENV production и APP_DEBUG false."""
    rows = [json.loads(line) for line in run(compose_cmd('ps', '--format', 'json')).stdout.splitlines() if line.strip()]
    health = {row['Service']: row.get('Health', '') for row in rows}
    report.check(health.get('web') == 'healthy', f'compose ps: web {health.get("web")!r}')
    report.check({'app', 'web', 'worker', 'scheduler', 'db'} <= set(health), f'compose ps: сервисы {sorted(health)}')
    gateway = run(['docker', 'network', 'inspect', f'{PROD_PROJECT}_default', '--format', '{{(index .IPAM.Config 0).Gateway}}']).stdout.strip()
    trusted = artisan('config:show', 'aiqme.trusted_proxies').stdout.split()
    report.check(gateway and trusted and trusted[-1] == gateway, f'aiqme.trusted_proxies {trusted[-1:]} ≠ шлюз сети {gateway}')
    cached = run(compose_cmd('exec', '-T', 'app', 'test', '-f', 'bootstrap/cache/config.php'), check=False).returncode == 0
    report.check(cached, 'в app нет bootstrap/cache/config.php — не выполнен optimize (§8.3)')
    for key, expected in (('app.env', 'production'), ('app.debug', 'false')):
        shown = artisan('config:show', key).stdout.split()
        report.check(shown[-1:] == [expected], f'{key} = {shown[-1:]}')
    report.check(values.get('STRIPE_SECRET', '') == '' and values.get('GOOGLE_SHEETS_KEY_BASE64', '') == ''
                 and values.get('TELEGRAM_BOT_TOKEN', '') == '', 'в build/prod-local/.env заданы ключи внешних сервисов')


def submit_quote(report, new_page, files, where, ship):
    """Калькулятор /en/quote (canvas отключён): файлы → PLA, 100 % → шаг 5 → заявка. Возвращает (номер, гостевая ссылка,
    секунды от отправки до страницы подтверждения)."""
    context, page, problems = new_page(1440, 1000, intercept=False)
    page.add_init_script('HTMLCanvasElement.prototype.getContext = () => null;')
    page.goto(BASE + '/en/quote', wait_until='networkidle')
    page.locator('#model-upload').set_input_files(files)
    page.wait_for_function(f"document.querySelectorAll('[data-files] .file-row').length === {len(files)}"
                           " && !document.querySelector('#upload-progress progress')", timeout=300000)
    report.check(page.locator('#quote-error .notice').count() == 0, f'{where}: ошибка калькулятора «{page.locator("#quote-error").inner_text()}»')
    for step in range(4):
        page.locator('[data-next]').evaluate('(node) => node.scrollIntoView({block: "center"})')
        page.click('[data-next]')
        if step == 0:
            page.select_option('select[name=material]', 'PLA')
            page.select_option('select[name=infill]', '100')
    form = '#checkout-form'
    page.fill(f'{form} [name=name]', 'Ona TEST')
    page.fill(f'{form} [name=email]', 'ona@example.test')
    page.fill(f'{form} [name=phone]', '+370 600 00000')
    if ship:
        page.select_option(f'{form} select[name=delivery]', 'ship')
        page.select_option(f'{form} select[name=country]', 'LT')
        page.fill(f'{form} [name=city]', 'Vilnius')
        page.fill(f'{form} [name=address]', 'Gedimino pr. 1')
        page.fill(f'{form} [name=postcode]', 'LT-01103')
    else:
        page.select_option(f'{form} select[name=delivery]', 'pickup')
    page.locator(f'{form} button[type=submit]').evaluate('(node) => node.scrollIntoView({block: "center"})')
    started = time.monotonic()
    page.click(f'{form} button[type=submit]')
    try:
        page.wait_for_url('**/quote/submitted', timeout=300000)
    except Exception as error:
        report.check(False, f'{where}: нет страницы подтверждения: {error}')
        context.close()
        return None, None, None
    seconds = time.monotonic() - started
    page.wait_for_load_state('networkidle')
    number = page.locator('[data-order-number]').get_attribute('data-order-number') or ''
    guest = page.locator('a[data-guest-link]').get_attribute('href') or ''
    report.check(number.isdigit() and guest.startswith(f'{BASE}/en/order/{number}/'), f'{where}: номер {number!r}, ссылка {guest!r}')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()
    return number, guest, seconds


def admin_card(page, number):
    page.goto(BASE + '/en/admin/orders', wait_until='networkidle')
    page.click(f'#admin-order-list tr:has(strong:text-is("{number}")) a.btn')
    page.wait_for_selector('#order-card')
    page.wait_for_load_state('networkidle')


def admin_scenario(report, new_page, state, number):
    """Администратор (вход через форму): STL скачивается; цена 150 EUR = 70 + 45 + плата 5 и доставка 30 → запрос аванса
    40 EUR (Stripe не вызывается) → производство при долге 110 EUR после подтверждения → трек."""
    where = f'админка, заказ {number}'
    context, page, problems = new_page(1440, 1000, storage_state=state)
    admin_card(page, number)
    page.click('#order-card button[aria-controls="bambu-job"]')
    page.wait_for_selector('#bambu-job')
    links = page.locator('#bambu-job a').evaluate_all('links => links.map(link => link.href)')
    report.check(len(links) == 2, f'{where}: ссылок STL {links}')
    for link in links:
        response = page.request.get(link)
        report.check(response.status == 200 and response.headers.get('content-disposition', '').startswith('attachment'),
                     f'{where}: скачивание {link} — {response.status}')
    prices = page.locator('#order-price-form input[name^="prices."]')
    report.check(prices.count() == 3, f'{where}: полей цены {prices.count()} (две детали и плата)')
    for index, value in enumerate(('70', '45', '5')[:prices.count()]):
        prices.nth(index).fill(value)
    page.fill('#order-price-form [name=delivery]', '30')
    page.click('#order-price-form button[type=submit]')
    page.wait_for_selector('#order-card .status-title .tag:text-is("Approved for production")')
    total = page.locator('#order-payment .summary-row').first.inner_text().replace('\xa0', ' ')
    report.check('€150.00' in total, f'{where}: итог после подтверждения «{total}»')

    page.fill('#order-request-form [name=amount]', '40')
    page.click('#order-request-form button[type=submit]')
    page.wait_for_selector('#order-card .notice.success:text-is("Payment request created.")')
    report.check('€40.00' in page.inner_text('#order-payment').replace('\xa0', ' '), f'{where}: нет запроса 40 EUR')

    page.click('#order-card .buttons button:has-text("In production")')
    page.wait_for_selector('#order-confirm')
    report.check('€150.00' in page.inner_text('#order-confirm').replace('\xa0', ' '), f'{where}: подтверждение без долга 150 EUR')
    page.click('#order-confirm button:text-is("Confirm")')
    page.wait_for_selector('#order-card .status-title .tag:text-is("In production")')

    page.fill('#order-tracking-form [name=carrier]', 'DPD')
    page.fill('#order-tracking-form [name=trackingNumber]', 'TEST-TRACK-1')
    page.click('#order-tracking-form button[type=submit]')
    page.wait_for_selector('#order-card .notice.success:text-is("Tracking saved.")')
    page.screenshot(path=str(OUT / 'shots' / 'prod-admin-order.png'), full_page=True)
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def guest_scenario(report, new_page, guest, number, secret):
    """Гость по ссылке: стадия «в производстве», трек, оплата — страница оплаты (без ключей Stripe — «недоступна»)
    и возврат после 3DS с payment_intent_client_secret. Возвращает адрес страницы оплаты."""
    where = f'гостевая страница {number}'
    context, page, problems = new_page(1440, 1000)
    response = page.goto(guest, wait_until='networkidle')
    report.check(response.status == 200 and page.locator('#customer-order').count() == 1, f'{where}: HTTP {response.status}')
    tracking = page.locator('[data-tracking]').inner_text() if page.locator('[data-tracking]').count() else ''
    report.check(tracking == 'Tracking: DPD TEST-TRACK-1', f'{where}: трек «{tracking}»')
    report.check('In production' in page.inner_text('#customer-order'), f'{where}: нет стадии In production')
    links = page.locator('#customer-order a[href*="/stl/"]').evaluate_all('links => links.map(link => link.href)')
    for link in links:
        # Referer с токеном, как у перехода по ссылке страницы: ответ ~25 МБ nginx буферизует (предупреждение с referrer).
        answer = page.request.get(link, headers={'Referer': guest})
        report.check(answer.status == 200, f'{where}: скачивание {link} гостем — {answer.status}')
    report.check(len(links) == 2, f'{where}: ссылки STL {links}')
    checkout = page.locator('a[data-checkout-link]')
    checkout_url = ''
    if report.check(checkout.count() == 1, f'{where}: кнопок оплаты {checkout.count()}'):
        checkout_url = checkout.get_attribute('href')
        checkout.click()
        page.wait_for_load_state('networkidle')
        report.check(page.locator('#checkout[data-checkout-status="unavailable"]').count() == 1, f'{where}: страница оплаты {page.url}')
        back = page.goto(f'{checkout_url}?payment_intent=pi_test_prodlocal&payment_intent_client_secret=pi_test_prodlocal_secret_{secret}'
                         '&redirect_status=succeeded', wait_until='networkidle')
        report.check(back.status == 200, f'{where}: возврат на страницу оплаты — {back.status}')
    page.screenshot(path=str(OUT / 'shots' / 'prod-guest-order.png'), full_page=True)
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()
    return checkout_url


def prod_contact(report, new_page):
    """Контактная заявка с двумя вложениями в prod-compose (W-29: данные копии bin/backup): сообщение об успехе; письмо
    не проверяется (в build/prod-local/.env MAIL_MAILER=log, Mailpit не подключён)."""
    where = '/en/contact prod-compose'
    context, page, problems = new_page(1440, 1000)
    page.goto(BASE + '/en/contact', wait_until='networkidle')
    with tempfile.TemporaryDirectory() as directory:
        pdf = Path(directory) / 'drawing.pdf'
        pdf.write_bytes(b'%PDF-1.4\n%browser-check prod\n' + secrets.token_bytes(64))
        stl = Path(directory) / 'part.stl'
        stl.write_text(f'solid part-{secrets.token_hex(8)}\nendsolid part\n')
        form = page.locator('#contact-form')
        form.locator('input[name=name]').fill('Ona TEST')
        form.locator('input[name=email]').fill('ona@example.test')
        form.locator('select[name=service]').select_option('3d-printing')
        form.locator('textarea[name=description]').fill('Need ten brackets printed in PETG.')
        form.locator('input[type=file]').set_input_files([str(pdf), str(stl)])
        wait_altcha(report, page, form, where)
        with page.expect_navigation(wait_until='networkidle'):
            form.locator('button[type=submit]').click()
    result = page.locator('#contact-result').inner_text().strip()
    report.check(result == 'AIQME has received your enquiry. Files attached: 2.', f'{where}: результат «{result}»')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def check_storage_volume(report):
    """Файл в томе storage/app/public отдаёт nginx по /storage/… (200, nosniff); PHP-файл оттуда не исполняется."""
    target = 'storage/app/public'
    with tempfile.TemporaryDirectory() as directory:
        png = png_file(directory, 'test.png').read_bytes()
    marker = secrets.token_hex(8)
    subprocess.run(compose_cmd('exec', '-T', '-u', 'www-data', 'app', 'sh', '-c', f'cat > {target}/w20-test.png'), cwd=APP, input=png, check=True)
    subprocess.run(compose_cmd('exec', '-T', '-u', 'www-data', 'app', 'sh', '-c', f'cat > {target}/w20-x.php'), cwd=APP,
                   input=f'<?php echo "EXEC-{marker}-" . (6 * 7);'.encode(), check=True)
    try:
        with urlopen(BASE + '/storage/w20-test.png', timeout=10) as response:
            report.check(response.status == 200 and response.read() == png and response.headers.get('X-Content-Type-Options') == 'nosniff'
                         and response.headers.get('Referrer-Policy') == 'same-origin',
                         f'/storage/w20-test.png: {response.status} {dict(response.headers)}')
        try:
            with urlopen(BASE + '/storage/w20-x.php', timeout=10) as response:
                status, body = response.status, response.read().decode(errors='replace')
        except OSError as error:
            status, body = getattr(error, 'code', 0), ''
        report.check(status in (200, 403, 404) and f'EXEC-{marker}-42' not in body, f'/storage/w20-x.php исполнен или ответ {status}: {body[:80]}')
        try:
            status = urlopen(BASE + '/.htaccess', timeout=10).status
        except OSError as error:
            status = getattr(error, 'code', 0)
        report.check(status == 403, f'/.htaccess (dot-файл public/) — {status}, а не 403')
    finally:
        run(compose_cmd('exec', '-T', '-u', 'www-data', 'app', 'rm', '-f', f'{target}/w20-test.png', f'{target}/w20-x.php'))


def prod_main(argv):
    global BASE, HOST
    BASE, values = prod_target(argv)
    HOST = urlparse(BASE).netloc
    os.chdir(APP)
    report = Report()
    OUT.mkdir(parents=True, exist_ok=True)
    (OUT / 'shots').mkdir(exist_ok=True)
    started = time.strftime('%Y-%m-%dT%H:%M:%S')
    log(f'== prod-compose {PROD_PROJECT}: {BASE}')
    services = check_prod_compose(report)
    log('== образы app и web')
    check_prod_image(report, services)
    log('== состояние сервисов')
    check_prod_runtime(report, values)

    # Администратор (D-29): случайный пароль только в stdin docker compose exec и в памяти процесса.
    admin_email, admin_password = 'admin@aiqme.test', secrets.token_urlsafe(24)
    artisan('aiqme:make-admin', admin_email, '--name=AIQME', '--password-stdin', '--no-interaction', stdin=admin_password + '\n')
    secret = secrets.token_urlsafe(24)
    reset_token = secrets.token_hex(32)
    tokens = {}
    timings = {}
    with tempfile.TemporaryDirectory() as directory, sync_playwright() as playwright:
        files = calculator_files(directory)
        large = [str(Path(directory) / f'large-{index:02}.stl') for index in range(1, 11)]
        for path in large:
            shutil.copyfile(files['large.stl'], path)
        browser = playwright.chromium.launch()

        def new_page(width, height, storage_state=None, intercept=True):
            context = browser.new_context(viewport={'width': width, 'height': height}, storage_state=storage_state)

            def foreign(url):
                return (url.startswith(('http:', 'https:', 'ws:', 'wss:')) and urlparse(url).netloc != HOST
                        and not MAP_EMBED.match(url))

            def abort(route):
                report.external.add(route.request.url)
                return route.abort()

            # Перехват Playwright закрывал вкладку на POST заявки из 10 файлов (~250 МБ): там чужие хосты только
            # фиксируются (их запросы и так запрещает CSP), на остальных страницах — прерываются.
            if intercept:
                context.route(foreign, abort)
            # После route(foreign, abort): позднее зарегистрированный обработчик Playwright срабатывает первым.
            context.route(MAP_EMBED, lambda route: map_stub(report, route))
            page = context.new_page()
            problems = []
            page.on('request', lambda r: report.external.add(r.url) if foreign(r.url) else None)
            page.on('console', lambda m: problems.append(f'console {m.type}: {m.text}')
                    if (m.type in ('error', 'warning') or 'Content Security Policy' in m.text)
                    and not m.text.startswith('Failed to load resource') else None)
            page.on('pageerror', lambda error: problems.append(f'pageerror: {error}'))
            page.on('response', lambda r: problems.append(f'{r.status} {r.url}') if r.status >= 400 and r.request.resource_type != 'document' else None)
            return context, page, problems

        log('== заявка гостя: куб 10 мм и STL 500 000 треугольников, доставка')
        number, guest, seconds = submit_quote(report, new_page, [str(STL_FIXTURES / 'cube-10mm-binary.stl'), files['large.stl']],
                                              'заявка из 2 STL', ship=True)
        if number:
            timings['2 STL (куб и 500 000 треугольников)'] = seconds
            tokens['гостевой токен'] = guest.rsplit('/', 1)[-1]
            state = sign_in(report, new_page, '/en/account/login', admin_email, admin_password, '/en/admin')
            log('== администратор: цена, запрос аванса, производство, трек')
            admin_scenario(report, new_page, state, number)
            log('== гость: трек и страница оплаты')
            guest_scenario(report, new_page, guest, number, secret)
            tokens['client_secret'] = secret
        log('== заявка из 10 STL по 500 000 треугольников')
        number10, _, seconds10 = submit_quote(report, new_page, large, 'заявка из 10 STL', ship=False)
        if number10:
            timings['10 STL по 500 000 треугольников'] = seconds10
        log('== контактная заявка с двумя вложениями (W-29)')
        prod_contact(report, new_page)
        # Ссылка сброса пароля (маршрут W-07): токен в пути не должен попасть в журнал доступа.
        context, page, _ = new_page(1440, 1000)
        page.goto(f'{BASE}/en/account/reset/{reset_token}?email=ona%40example.test', wait_until='networkidle')
        tokens['токен сброса'] = reset_token
        context.close()
        browser.close()
    with urlopen(BASE + '/lt', timeout=10) as response:
        report.check(response.status == 200, f'GET /lt — {response.status}')

    log('== том storage: /storage/… и PHP-файл')
    check_storage_volume(report)

    log('== журнал web')
    logs = run(compose_cmd('logs', '--no-log-prefix', '--since', started, 'web')).stdout
    report.check(re.search(r'"GET /lt HTTP/1\.1" 200 ', logs) is not None, 'журнал web не содержит обычного запроса GET /lt (журнал выключен?)')
    for name, token in tokens.items():
        report.check(token not in logs, f'журнал web содержит {name}')
    report.check('http://' not in logs and 'Referer' not in logs, 'журнал web содержит Referer')

    report.check(not report.external, f'запросы к чужим хостам: {sorted(report.external)}')
    lines = [f'# bin/browser-check --base-url {BASE} — {time.strftime("%Y-%m-%d %H:%M")}', '',
             f'- Итог: {"FAIL" if report.failures else "OK"}; проверок пройдено {report.passed}, ошибок {len(report.failures)}.',
             '- Время от отправки заявки до страницы подтверждения: ' + '; '.join(f'{k} — {v:.1f} с' for k, v in timings.items()),
             '- Прерванные запросы к чужим хостам: ' + (', '.join(sorted(report.external)) or 'нет'),
             f'- Карта Google Maps (контакты): подменена заглушкой {report.map_stubbed} раз', ''] + [f'- FAIL {f}' for f in report.failures]
    (OUT / 'prod-summary.md').write_text('\n'.join(lines) + '\n', encoding='utf-8')
    for name, value in timings.items():
        log(f'   время заявки ({name}): {value:.1f} с')
    if report.failures:
        log(f'\nbin/browser-check --base-url: FAIL ({len(report.failures)})')
        for failure in report.failures:
            log(' - ' + failure)
        sys.exit(1)
    log(f'\nbin/browser-check --base-url: OK ({report.passed} проверок); отчёт {OUT / "prod-summary.md"}')


def main():
    os.chdir(APP)
    if '--base-url' in sys.argv or '--compose-file' in sys.argv:
        return prod_main(sys.argv[1:])
    arguments = [a for a in sys.argv[1:] if not a.startswith('-')]
    env = browser_env()
    log('== подготовка БД aiqme_browser')
    accounts = prepare(env)
    log('== сборка Vite')
    build_assets()
    pages, skipped_ru = pages_from_routes(env)
    allowlist = load_allowlist()
    text_allowlist = load_allowlist(TEXT_ALLOWLIST)
    blocks = json.loads(BLOCKS.read_text(encoding='utf-8'))
    log(f'== сервер {BASE} (bin/php -S)')
    server = start_server(env)
    pages = arguments or sorted(set(pages[:-len(NOT_FOUND_PAGES)] + pages_from_sitemap())) + SEARCH_PAGES + CATALOG_PAGES + NOT_FOUND_PAGES
    report = Report()
    OUT.mkdir(parents=True, exist_ok=True)
    shots_dir = OUT / 'shots'
    shutil.rmtree(shots_dir, ignore_errors=True)
    shots_dir.mkdir()
    rows = []
    discrepancies = []
    try:
        with sync_playwright() as playwright:
            browser = playwright.chromium.launch()
            csp = urlopen(BASE + '/lt').headers['Content-Security-Policy']
            manifest = json.loads((APP / 'public' / 'build' / 'manifest.json').read_text())
            assets = ''.join(f'<link rel="stylesheet" href="/build/{css}">' for css in manifest['resources/js/app.js'].get('css', []))
            assets += f'<link rel="stylesheet" href="/build/{manifest["resources/css/app.css"]["file"]}">'
            assets += f'<script type="module" src="/build/{manifest["resources/js/app.js"]["file"]}"></script>'

            log('== самопроверка детекторов и модального окна')
            self_test(report, browser, csp, assets)

            def new_page(width, height, reduced_motion='no-preference', storage_state=None, java_script_enabled=True):
                context = browser.new_context(viewport={'width': width, 'height': height}, reduced_motion=reduced_motion,
                                              storage_state=storage_state, java_script_enabled=java_script_enabled)

                def guard(route):
                    if MAP_EMBED.match(route.request.url):
                        return map_stub(report, route)
                    host = route.request.url.split('/')[2] if '://' in route.request.url else ''
                    if host != HOST and not route.request.url.startswith(('data:', 'blob:')):
                        report.external.add(route.request.url)
                        return route.abort()
                    return route.continue_()

                context.route('**/*', guard)
                page = context.new_page()
                problems = []
                # «Failed to load resource» дублирует ответы ≥400, их ловит обработчик response (без самой страницы 404).
                page.on('console', lambda m: problems.append(f'console {m.type}: {m.text}')
                        if (m.type in ('error', 'warning') or 'Content Security Policy' in m.text)
                        and not m.text.startswith('Failed to load resource') else None)
                page.on('pageerror', lambda error: problems.append(f'pageerror: {error}'))
                page.on('response', lambda r: problems.append(f'{r.status} {r.url}') if r.status >= 400 and r.request.resource_type != 'document' else None)
                return context, page, problems

            if not arguments or '--signed-in' in sys.argv:
                check_accounts(report, new_page, accounts, skipped_ru, allowlist)

            log(f'== страницы: {len(pages)}')
            for path in pages:
                expect_status = 404 if path in NOT_FOUND_PAGES else 200
                for width in WIDTHS:
                    height = {320: 568, 390: 844, 768: 1024, 1024: 768, 1440: 1000}[width]
                    context, page, problems = new_page(width, height)
                    response = page.goto(BASE + path, wait_until='networkidle')
                    where = f'{path} @{width}'
                    report.check(response.status == expect_status, f'{where}: HTTP {response.status}')
                    scroll, client = document_fits(page)
                    report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
                    check_gutters(report, page, where, width)
                    if width in STYLE_WIDTHS:
                        check_styles(report, page, path, width)
                    if path in ('/lt', '/en'):
                        check_hero_under_header(report, page, where, width)
                    if width in (390, 1440):
                        for hit in marker_hits(page, path, allowlist):
                            report.check(False, f'{where}: маркер {hit}')
                    if path in blocks and width == 1440:
                        check_blocks(report, page, path, blocks)
                        check_text(report, page, path, text_allowlist, discrepancies)
                    if width == 1440:
                        check_focus_style(report, page, path)
                        page.reload(wait_until='networkidle')
                        check_cookie(report, page, path)
                    if path in ('/lt', '/en', NOT_FOUND_PAGES[0]) and width <= 900 or width == 1440:
                        page.reload(wait_until='networkidle')
                        check_menu(report, page, path, width, height)
                    if expect_status == 200 and width in (390, 1440):
                        check_media(report, page, path)
                    if path in DEFAULT_MEDIA and width in (390, 1440):
                        check_defaults(report, page, path, width)
                    for problem in problems:
                        report.check(False, f'{where}: {problem}')
                    context.close()

                if path in GUTTER_1280_PAGES:
                    context, page, problems = new_page(1280, 900)
                    page.goto(BASE + path, wait_until='networkidle')
                    scroll, client = document_fits(page)
                    report.check(scroll <= client, f'{path} @1280: документ шире окна ({scroll} > {client})')
                    check_gutters(report, page, f'{path} @1280', 1280)
                    context.close()
                if path in HEADER_PAGES:
                    for width in (390, 1440):
                        check_header(report, new_page, path, width)
                if path in ('/lt', '/en'):
                    check_logo(report, new_page, path)
                if path == '/lt/apie-mus':
                    check_header_cases(report, new_page, path)
                if path in ('/lt', '/en'):
                    check_motion(report, browser, new_page, path)
                if path in ('/en', '/lt/paieska?q=3D'):
                    for width, height in ((390, 844), (1440, 1000)):
                        check_search_modal(report, new_page, path, width, height)
                if path in ('/lt/produktai', '/en/products'):
                    for width, height in ((390, 844), (1440, 1000)):
                        check_compare(report, new_page, path, width, height)
                if path in CALCULATOR_PAGES:
                    with tempfile.TemporaryDirectory() as directory:
                        files = calculator_files(directory)
                        for width in (390, 1440):
                            check_calculator(report, new_page, path, width, allowlist, files)
                            check_viewer(report, new_page, path, width, files)
                if path in CONTACT_PAGES:
                    for width in (390, 1440):
                        check_contact_map(report, new_page, path, width, shots_dir)
                if path == '/en/contact':
                    check_contact_form(report, new_page, path, FORM_PAGES[path])
                elif path in FORM_PAGES:
                    check_training_modal(report, new_page, path, FORM_PAGES[path])
                if path == '/lt/paskyra/register':
                    check_register(report, new_page, path, 390)

                row = {'path': path, 'shots': {}}
                for device, (width, height) in SHOTS.items():
                    context, page, _ = new_page(width, height)
                    page.goto(BASE + path, wait_until='networkidle')
                    file = shots_dir / f'{path.strip("/").replace("/", "__") or "root"}-{device}.png'
                    page.screenshot(path=str(file))
                    row['shots'][device] = (file, evidence_shot(path, device))
                    context.close()
                rows.append(row)
                log(f'   {path}: ok' if not report.failures else f'   {path}: ошибок всего {len(report.failures)}')
            browser.close()
    finally:
        server.terminate()
        server.wait()

    write_report(report, pages, skipped_ru, rows, signed_in=not arguments or '--signed-in' in sys.argv)
    (OUT / 'text-discrepancies.md').write_text('# Сверка текста main с эталоном (W-05)\n\n'
        + ('\n'.join(f'- {line}' for line in discrepancies) or 'Расхождений нет.') + '\n', encoding='utf-8')
    if report.failures:
        log(f'\nbin/browser-check: FAIL ({len(report.failures)})')
        for failure in report.failures[:200]:
            log(' - ' + failure)
        sys.exit(1)
    log(f'\nbin/browser-check: OK ({report.passed} проверок)')


def write_report(report, pages, skipped_ru, rows, signed_in):
    have_evidence = (EVIDENCE / 'verified-route-screens.json').exists()
    lines = [
        f'# bin/browser-check — {time.strftime("%Y-%m-%d %H:%M")}', '',
        f'- Итог: {"FAIL" if report.failures else "OK"}; проверок пройдено {report.passed}, ошибок {len(report.failures)}.',
        f'- Страницы ({len(pages)}): ' + ', '.join(pages),
        ('- Вход через форму (W-07): администратор и клиент; кабинет ' + ', '.join(ACCOUNT_PAGES) + '; админка '
         + ', '.join(ADMIN_PAGES) + f'; /ru/ ({len(skipped_ru)} адресов) — 200 с noindex; профиль, выход, сброс пароля по письму из Mailpit.'
         if signed_in else '- Вход, кабинет, админка и /ru/ — не проверялись (запуск с путями).'),
        '- Прерванные запросы к чужим хостам: ' + (', '.join(sorted(report.external)) or 'нет'),
        f'- Карта Google Maps (контакты): подменена заглушкой {report.map_stubbed} раз',
        '- Сверка текста с эталоном: text-discrepancies.md; заметки: ' + ('; '.join(report.notes) or 'нет'),
        '- Кадры рядом с эталоном: ' + ('report.html' if have_evidence else 'не проверено (нет эталона)')
        + '; ручной просмотр — ждёт проверки пользователем.', '',
    ] + [f'- FAIL {failure}' for failure in report.failures]
    (OUT / 'summary.md').write_text('\n'.join(lines) + '\n', encoding='utf-8')

    cells = []
    for row in rows:
        cells.append(f'<h2>{html.escape(row["path"])}</h2><table><tr><th>Размер</th><th>Наш кадр</th><th>Эталон прототипа</th></tr>')
        for device, (ours, reference) in row['shots'].items():
            ref = f'<img src="{reference.as_uri()}">' if reference else 'не проверено (нет эталона)'
            cells.append(f'<tr><td>{device}</td><td><img src="{ours.relative_to(OUT)}"></td><td>{ref}</td></tr>')
        cells.append('</table>')
    (OUT / 'report.html').write_text(
        '<!DOCTYPE html><meta charset="utf-8"><title>AIQME: наш кадр рядом с эталоном</title>'
        '<style>img{max-width:640px;border:1px solid #ccc;vertical-align:top}td{vertical-align:top}</style>'
        '<p>Эталон не копируется: ссылки на локальные файлы evidence/. Ручной просмотр — ждёт проверки пользователем.</p>'
        + ''.join(cells), encoding='utf-8')
    log(f'Отчёт: {OUT / "summary.md"}, {OUT / "report.html"}')


if __name__ == '__main__':
    main()
