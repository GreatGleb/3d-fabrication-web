# Блоки эталона без нашей пары: демо-блоки и блок команды (как в prototype-blocks.json), расписание обучения (темы и даты —
# черновики, D-21: исключается всегда).
TEXT_EXCLUDED_BLOCKS = [('div', {'notice'}), ('div', {'inset', 'gap'}, '/(lt/apie-mus|en/about)$'), ('div', {'grid', 'two'}, None, ('div', {'gap'}))]
NO_TEXT = {'script', 'style', 'template', 'noscript', 'svg'}


class ReferenceText(HTMLParser):
    """Текст main эталона по узлам (тег, классы, родитель) — только чтение dom.html как текста."""
    VOID = {'area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'source', 'track', 'wbr'}

    def __init__(self):
        super().__init__()
        self.root = {'tag': 'root', 'cls': set(), 'children': [], 'parent': None}
        self.stack = [self.root]

    def handle_starttag(self, tag, attrs):
        node = {'tag': tag, 'cls': set((dict(attrs).get('class') or '').split()), 'children': [], 'parent': self.stack[-1]}
        self.stack[-1]['children'].append(node)
        if tag not in self.VOID:
            self.stack.append(node)

    def handle_endtag(self, tag):
        for i in range(len(self.stack) - 1, 0, -1):
            if self.stack[i]['tag'] == tag:
                del self.stack[i:]
                return

    def handle_data(self, data):
        self.stack[-1]['children'].append(data)


def reference_phrases(path, has_project):
    """Фразы видимого текста main эталона по порядку после исключений; None — эталона нет."""
    file = EVIDENCE / 'verified-route-screens' / (path.strip('/').replace('/', '__')) / 'dom.html'
    if not file.exists():
        return None
    parser = ReferenceText()
    parser.feed(file.read_text(encoding='utf-8'))

    def find(node):
        if isinstance(node, dict):
            if node['tag'] == 'main':
                return node
            for child in node['children']:
                found = find(child)
                if found:
                    return found
        return None

    def excluded(node):
        for rule in TEXT_EXCLUDED_BLOCKS:
            tag, classes = rule[0], rule[1]
            page_rule = rule[2] if len(rule) > 2 else None
            parent_rule = rule[3] if len(rule) > 3 else None
            if node['tag'] == tag and node['cls'] == classes and (page_rule is None or re.search(page_rule, path)):
                parent = node['parent']
                if parent_rule is None or (parent['tag'] == parent_rule[0] and parent['cls'] == parent_rule[1]):
                    return True
        if not has_project and 'project-card' in node['cls']:
            return True  # пример — карточка опубликованного проекта, без него не выводится (§4.1)
        if not has_project and node['tag'] == 'div' and node['cls'] == {'section-head'} and re.search(r'/(paslaugos|services)/', path):
            siblings = [c for c in node['parent']['children'] if isinstance(c, dict)]
            index = siblings.index(node)
            return index + 1 < len(siblings) and siblings[index + 1]['cls'] == {'grid', 'two'}
        return False

    phrases = []

    def walk(node):
        for child in node['children']:
            if isinstance(child, str):
                text = ' '.join(child.split())
                for original, replacement in D21_REPLACEMENTS:
                    text = text.replace(original, replacement)
                text = ' '.join(text.split())
                if text:
                    phrases.append(text)
            elif child['tag'] not in NO_TEXT and not excluded(child):
                walk(child)

    walk(find(parser.root))
    return phrases


OUR_TEXT = """() => {
    const walker = document.createTreeWalker(document.querySelector('main'), NodeFilter.SHOW_TEXT, {acceptNode: (node) =>
        node.parentElement.closest('script, style, template, noscript, [hidden]') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT});
    const parts = [];
    while (walker.nextNode()) { const text = walker.currentNode.nodeValue.replace(/\\s+/g, ' ').trim(); if (text) parts.push(text); }
    return parts.join(' ');
}"""


def check_text(report, page, path, allowlist, discrepancies):
    """Каждая фраза эталона (после исключений) есть в нашем main в том же порядке (done[8] W-05)."""
    phrases = reference_phrases(path, page.locator('main .project-card').count() > 0)
    if phrases is None:
        discrepancies.append(f'{path}: не проверено (нет эталона)')
        return
    allowed = {entry['phrase'] for entry in allowlist if entry['page'] == path}
    ours = page.evaluate(OUR_TEXT)
    position = 0
    for phrase in phrases:
        if phrase in allowed:
            continue
        found = ours.find(phrase, position)
        if report.check(found >= 0, f'{path}: нет фразы эталона «{phrase[:120]}» (после позиции {position})'):
            position = found + len(phrase)
        else:
            discrepancies.append(f'{path}: нет «{phrase}»')


MEDIA_PROBE = """async () => {
    const result = [];
    for (const frame of document.querySelectorAll('main .hero-art, main .service-feature-media, main .media-frame, main .split-image, main .project-image')) {
        frame.scrollIntoView({block: 'center'});
        const img = frame.querySelector(':scope > img');
        if (img) { await img.decode().catch(() => {}); }
        const art = frame.querySelector(':scope > svg.placeholder-art');
        const box = art && art.getBoundingClientRect();
        result.push({frame: frame.className, image: img ? img.naturalWidth : null,
            art: !!(box && box.width > 0 && box.height > 0 && getComputedStyle(art).visibility === 'visible'),
            prototypeImage: [...frame.querySelectorAll('img')].some((i) => /\\/assets\\//.test(i.src))});
    }
    window.scrollTo(0, 0);
    return result;
}"""


def check_media(report, page, path):
    """Медиа или своя заглушка отрисованы (naturalWidth > 0 либо видимый SVG); изображений прототипа нет (§7.2, F-47)."""
    for frame in page.evaluate(MEDIA_PROBE):
        report.check((frame['image'] or 0) > 0 or frame['art'], f'{path}: медиа не отрисовано в {frame}')
        report.check(not frame['prototypeImage'], f'{path}: изображение прототипа в {frame["frame"]}')


MOTION_PROBE = """() => {
    const video = document.getElementById('hero-video');
    const tracks = [...document.querySelectorAll('.partner-marquee-track, .news-marquee-track')];
    return {
        video: video && {paused: video.paused, autoplay: video.hasAttribute('autoplay'), poster: video.poster, preload: video.preload,
            visible: video.getBoundingClientRect().height > 0, mobile: [...video.querySelectorAll('source')].map((s) => s.media)},
        tracks: tracks.map((t) => ({animation: getComputedStyle(t).animationName,
            duplicates: [...t.querySelectorAll('[aria-hidden="true"]')].filter((g) => g.getBoundingClientRect().width > 0).length,
            transform: getComputedStyle(t).transform})),
    };
}"""


def check_motion(report, browser, new_page, path, hero_video):
    """Видео hero и ленты (§7.3) на данных фабрик: с reduced-motion — пауза, без autoplay, постер, лента без анимации
    и дублей; без него — видео играет, лента движется, кнопка паузы её останавливает."""
    context, page, _ = new_page(1440, 1000, reduced_motion='reduce')
    page.goto(BASE + path, wait_until='networkidle')
    page.wait_for_timeout(800)
    got = page.evaluate(MOTION_PROBE)
    video = got['video']
    if not hero_video:
        report.notes.append(f'{path}: видео hero не проверено (нет ffmpeg — ролик не создан)')
    elif report.check(video is not None, f'{path}: нет видео hero при медиа hero'):
        report.check(video['paused'] and not video['autoplay'], f'{path} reduced-motion: видео играет или autoplay {video}')
        report.check(bool(video['poster']) and video['visible'], f'{path} reduced-motion: нет постера {video}')
        if video['poster']:
            report.check(page.request.get(video['poster']).status == 200, f'{path}: постер не загружается {video["poster"]}')
        report.check(video['preload'] == 'metadata' and '(max-width: 700px)' in video['mobile'], f'{path}: preload/мобильный источник {video}')
    report.check(len(got['tracks']) == 2, f'{path}: ожидались ленты брендов и новостей (данные фабрик), найдено {len(got["tracks"])}')
    for track in got['tracks']:
        report.check(track['animation'] == 'none' and track['duplicates'] == 0, f'{path} reduced-motion: лента {track}')
    context.close()

    context, page, _ = new_page(1440, 1000)
    page.goto(BASE + path, wait_until='networkidle')
    page.mouse.move(1, 1)
    if hero_video:
        try:
            page.wait_for_function("() => { const v = document.getElementById('hero-video'); return v && !v.paused; }", timeout=5000)
            report.check(True, '')
        except Exception:  # noqa: BLE001 — таймаут ожидания и есть провал проверки
            report.check(False, f'{path}: без reduced-motion видео hero не играет')
    for selector in ('.partner-section', '.news-section'):
        track = page.locator(f'{selector} [class$="-marquee-track"]')
        before = track.evaluate('(t) => getComputedStyle(t).transform')
        page.wait_for_timeout(400)
        moved = track.evaluate('(t) => getComputedStyle(t).transform')
        report.check(before != moved, f'{path}: лента {selector} не движется')
        page.locator(f'{selector} .partner-motion-toggle').click()
        page.mouse.move(1, 1)
        stopped = track.evaluate('(t) => getComputedStyle(t).transform')
        page.wait_for_timeout(400)
        report.check(stopped == track.evaluate('(t) => getComputedStyle(t).transform'), f'{path}: пауза не остановила ленту {selector}')
        report.check(page.locator(f'{selector} .partner-motion-toggle').get_attribute('aria-pressed') == 'true', f'{path}: aria-pressed паузы {selector}')
    context.close()


SELF_TEST_PATH = '/__browser-check-self-test'


def self_test(report, browser, csp, assets):
    """Детекторы ловят нарушения: маркер, CSP, переполнение; модальное окно — на настоящем JS приложения."""
    context = browser.new_context(viewport={'width': 390, 'height': 844})
    page = context.new_page()
    console = []
    page.on('console', lambda message: console.append(message.text))
    body = f"""<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">{assets}</head><body>
<main id="main"><h1>Demonstration website</h1><p style="width:1200px">wide</p>
<script>window.inlineRan = true;</script>
<button id="opener" data-modal-open="dialog">Open</button><a href="#x" id="outside">Outside</a>
<div class="search-overlay" id="dialog" data-modal hidden><section class="search-panel" role="dialog" aria-modal="true" aria-labelledby="dialog-title">
<button type="button" data-modal-close aria-label="Close">×</button><h2 id="dialog-title">Title</h2>
<input name="first" aria-label="First"><button type="button" id="last">Last</button></section></div></main></body></html>"""
    page.route(BASE + SELF_TEST_PATH, lambda route: route.fulfill(status=200, body=body,
               headers={'Content-Type': 'text/html; charset=utf-8', 'Content-Security-Policy': csp}))
    page.goto(BASE + SELF_TEST_PATH)
    page.wait_for_load_state('networkidle')
    scroll, client = document_fits(page)
    report.check(scroll > client, 'самопроверка: переполнение документа не обнаружено')
    report.check(any('Content Security Policy' in text for text in console) and not page.evaluate('window.inlineRan === true'),
                 'самопроверка: inline-скрипт без nonce не заблокирован CSP или нарушение не видно в консоли')
    report.check(any('demonstr' in hit for hit in marker_hits(page, SELF_TEST_PATH, [])), 'самопроверка: маркер «Demonstration» не найден')
    report.check(marker_hits(page, SELF_TEST_PATH, [{'page': SELF_TEST_PATH, 'phrase': 'Demonstration website'}]) == [],
                 'самопроверка: точная фраза из allowlist не разрешила совпадение')

    page.locator('#opener').click()
    dialog = page.locator('#dialog')
    report.check(dialog.is_visible(), 'модальное окно: не открылось')
    report.check(page.evaluate("document.activeElement.matches('[data-modal-close]')"), 'модальное окно: фокус не внутри')
    report.check(page.evaluate("document.querySelector('main').inert === true"), 'модальное окно: фон не inert')
    page.locator('#last').focus()
    page.keyboard.press('Tab')
    report.check(page.evaluate("document.activeElement.matches('[data-modal-close]')"), 'модальное окно: Tab вышел из окна')
    page.keyboard.press('Shift+Tab')
    report.check(page.evaluate("document.activeElement.id === 'last'"), 'модальное окно: Shift+Tab вышел из окна')
    page.keyboard.press('Escape')
    report.check(not dialog.is_visible(), 'модальное окно: Escape не закрыл')
    report.check(page.evaluate("document.activeElement.id === 'opener'"), 'модальное окно: фокус не вернулся на кнопку')
    report.check(page.evaluate("document.querySelector('main').inert === false"), 'модальное окно: фон остался inert')
    page.locator('#opener').click()
    page.mouse.click(5, 5)
    report.check(not dialog.is_visible(), 'модальное окно: щелчок по фону не закрыл')
    context.close()


def evidence_shot(path, device):
    """Кадр эталона для пути (по verified-route-screens.json); None — эталона нет."""
    index = EVIDENCE / 'verified-route-screens.json'
    if not index.exists():
        return None
    prototype_path = path.rstrip('/') + '/'
    for entry in json.loads(index.read_text()):
        if entry['path'] == prototype_path and entry['device'] == device:
            shot = EVIDENCE / entry['file']
            return shot if shot.exists() else None
    return None


def main():
    os.chdir(APP)
    arguments = [a for a in sys.argv[1:] if not a.startswith('-')]
    env = browser_env()
    log('== подготовка БД aiqme_browser')
    accounts = prepare(env)
    log('== сборка Vite')
    build_assets()
    pages, skipped_ru = pages_from_routes(env)
    allowlist = load_allowlist()
    text_allowlist = load_allowlist(TEXT_ALLOWLIST)
    blocks = json.loads(BLOCKS.read_text(encoding='utf-8'))
    log(f'== сервер {BASE} (bin/php -S)')
    server = start_server(env)
    pages = arguments or sorted(set(pages[:-len(NOT_FOUND_PAGES)] + pages_from_sitemap())) + NOT_FOUND_PAGES
    report = Report()
    OUT.mkdir(parents=True, exist_ok=True)
    shots_dir = OUT / 'shots'
    shutil.rmtree(shots_dir, ignore_errors=True)
    shots_dir.mkdir()
    rows = []
    discrepancies = []
    try:
        with sync_playwright() as playwright:
            browser = playwright.chromium.launch()
            csp = urlopen(BASE + '/lt').headers['Content-Security-Policy']
            manifest = json.loads((APP / 'public' / 'build' / 'manifest.json').read_text())
            assets = ''.join(f'<link rel="stylesheet" href="/build/{css}">' for css in manifest['resources/js/app.js'].get('css', []))
            assets += f'<link rel="stylesheet" href="/build/{manifest["resources/css/app.css"]["file"]}">'
            assets += f'<script type="module" src="/build/{manifest["resources/js/app.js"]["file"]}"></script>'

            log('== самопроверка детекторов и модального окна')
            self_test(report, browser, csp, assets)

            def new_page(width, height, reduced_motion='no-preference'):
                context = browser.new_context(viewport={'width': width, 'height': height}, reduced_motion=reduced_motion)

                def guard(route):
                    host = route.request.url.split('/')[2] if '://' in route.request.url else ''
                    if host != HOST and not route.request.url.startswith(('data:', 'blob:')):
                        report.external.add(route.request.url)
                        return route.abort()
                    return route.continue_()

                context.route('**/*', guard)
                page = context.new_page()
                problems = []
                # «Failed to load resource» дублирует ответы ≥400, их ловит обработчик response (без самой страницы 404).
                page.on('console', lambda m: problems.append(f'console {m.type}: {m.text}')
                        if (m.type in ('error', 'warning') or 'Content Security Policy' in m.text)
                        and not m.text.startswith('Failed to load resource') else None)
                page.on('pageerror', lambda error: problems.append(f'pageerror: {error}'))
                page.on('response', lambda r: problems.append(f'{r.status} {r.url}') if r.status >= 400 and r.request.resource_type != 'document' else None)
                return context, page, problems

            log(f'== страницы: {len(pages)}')
            for path in pages:
                expect_status = 404 if path in NOT_FOUND_PAGES else 200
                for width in WIDTHS:
                    height = {320: 568, 390: 844, 768: 1024, 1024: 768, 1440: 1000}[width]
                    context, page, problems = new_page(width, height)
                    response = page.goto(BASE + path, wait_until='networkidle')
                    where = f'{path} @{width}'
                    report.check(response.status == expect_status, f'{where}: HTTP {response.status}')
                    scroll, client = document_fits(page)
                    report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
                    if width in STYLE_WIDTHS:
                        check_styles(report, page, path, width)
                    if width in (390, 1440):
                        for hit in marker_hits(page, path, allowlist):
                            report.check(False, f'{where}: маркер {hit}')
                    if path in blocks and width == 1440:
                        check_blocks(report, page, path, blocks)
                        check_text(report, page, path, text_allowlist, discrepancies)
                    if width == 1440:
                        check_focus_style(report, page, path)
                        page.reload(wait_until='networkidle')
                        check_cookie(report, page, path)
                    if path in ('/lt', '/en', NOT_FOUND_PAGES[0]) and width <= 900 or width == 1440:
                        page.reload(wait_until='networkidle')
                        check_menu(report, page, path, width, height)
                    if expect_status == 200 and width in (390, 1440):
                        check_media(report, page, path)
                    for problem in problems:
                        report.check(False, f'{where}: {problem}')
                    context.close()

                if path in ('/lt', '/en'):
                    check_motion(report, browser, new_page, path, accounts['hero_video'])

                row = {'path': path, 'shots': {}}
                for device, (width, height) in SHOTS.items():
                    context, page, _ = new_page(width, height)
                    page.goto(BASE + path, wait_until='networkidle')
                    file = shots_dir / f'{path.strip("/").replace("/", "__") or "root"}-{device}.png'
                    page.screenshot(path=str(file))
                    row['shots'][device] = (file, evidence_shot(path, device))
                    context.close()
                rows.append(row)
                log(f'   {path}: ok' if not report.failures else f'   {path}: ошибок всего {len(report.failures)}')
            browser.close()
    finally:
        server.terminate()
        server.wait()

    write_report(report, pages, skipped_ru, rows)
    (OUT / 'text-discrepancies.md').write_text('# Сверка текста main с эталоном (W-05)\n\n'
        + ('\n'.join(f'- {line}' for line in discrepancies) or 'Расхождений нет.') + '\n', encoding='utf-8')
    if report.failures:
        log(f'\nbin/browser-check: FAIL ({len(report.failures)})')
        for failure in report.failures[:200]:
            log(' - ' + failure)
        sys.exit(1)
    log(f'\nbin/browser-check: OK ({report.passed} проверок)')


def write_report(report, pages, skipped_ru, rows):
    have_evidence = (EVIDENCE / 'verified-route-screens.json').exists()
    lines = [
        f'# bin/browser-check — {time.strftime("%Y-%m-%d %H:%M")}', '',
        f'- Итог: {"FAIL" if report.failures else "OK"}; проверок пройдено {report.passed}, ошибок {len(report.failures)}.',
        f'- Страницы ({len(pages)}): ' + ', '.join(pages),
        f'- {SKIPPED_LOGIN}: кабинет, админка и /ru/ ({len(skipped_ru)} адресов /ru).',
        '- Прерванные запросы к чужим хостам: ' + (', '.join(sorted(report.external)) or 'нет'),
        '- Сверка текста с эталоном: text-discrepancies.md; заметки: ' + ('; '.join(report.notes) or 'нет'),
        '- Кадры рядом с эталоном: ' + ('report.html' if have_evidence else 'не проверено (нет эталона)')
        + '; ручной просмотр — ждёт проверки пользователем.', '',
    ] + [f'- FAIL {failure}' for failure in report.failures]
    (OUT / 'summary.md').write_text('\n'.join(lines) + '\n', encoding='utf-8')

    cells = []
    for row in rows:
        cells.append(f'<h2>{html.escape(row["path"])}</h2><table><tr><th>Размер</th><th>Наш кадр</th><th>Эталон прототипа</th></tr>')
        for device, (ours, reference) in row['shots'].items():
            ref = f'<img src="{reference.as_uri()}">' if reference else 'не проверено (нет эталона)'
            cells.append(f'<tr><td>{device}</td><td><img src="{ours.relative_to(OUT)}"></td><td>{ref}</td></tr>')
        cells.append('</table>')
    (OUT / 'report.html').write_text(
        '<!DOCTYPE html><meta charset="utf-8"><title>AIQME: наш кадр рядом с эталоном</title>'
        '<style>img{max-width:640px;border:1px solid #ccc;vertical-align:top}td{vertical-align:top}</style>'
        '<p>Эталон не копируется: ссылки на локальные файлы evidence/. Ручной просмотр — ждёт проверки пользователем.</p>'
        + ''.join(cells), encoding='utf-8')
    log(f'Отчёт: {OUT / "summary.md"}, {OUT / "report.html"}')


if __name__ == '__main__':
    main()
