MARKER_ATTRIBUTES = ['placeholder', 'aria-label', 'title', 'alt', 'value']


def log(message):
    print(message, flush=True)


def run(args, *, env=None, stdin=None, check=True):
    result = subprocess.run(args, cwd=APP, env=env, input=stdin, text=True, capture_output=True)
    if check and result.returncode != 0:
        sys.exit(f'FAIL: {" ".join(args[:4])}…: код {result.returncode}\n{result.stdout[-2000:]}\n{result.stderr[-2000:]}')
    return result


# ---------- подготовка ----------

def browser_env():
    env = dict(os.environ)
    env.update({'DB_DATABASE': DATABASE, 'QUEUE_CONNECTION': 'sync', 'APP_URL': BASE, 'APP_ENV': 'local',
                'APP_DEBUG': 'false',
                # Заявки W-12 одного прогона (несколько страниц, ширин и ошибочных отправок) — с одного IP; лимит поднят.
                'AIQME_ORDERS_PER_HOUR': '100',
                # Stripe на уровне L не вызывается (W-16): без ключей страница оплаты — «оплата временно недоступна».
                'STRIPE_KEY': '', 'STRIPE_SECRET': ''})
    return env


def node_env():
    env = dict(os.environ)
    nvm = sorted(Path.home().glob('.nvm/versions/node/v*/bin'), key=lambda p: [int(x) for x in p.parent.name[1:].split('.')])
    if nvm:
        env['PATH'] = f'{nvm[-1]}:{env["PATH"]}'
    return env


def port_in_use():
    with socket.socket() as sock:
        return sock.connect_ex(('127.0.0.1', PORT)) == 0


def prepare(env):
    if (APP / 'bootstrap' / 'cache' / 'config.php').exists():
        sys.exit('FAIL: есть bootstrap/cache/config.php — переменные окружения (DB_DATABASE) не подействуют; bin/php artisan config:clear')
    run(['docker', 'compose', '-f', 'docker-compose.dev.yml', 'up', '-d', '--wait', 'postgres', 'mailpit'])
    exists = run(['docker', 'compose', '-f', 'docker-compose.dev.yml', 'exec', '-T', 'postgres', 'psql', '-U', 'aiqme', '-d', 'aiqme',
                  '-tAc', f"SELECT 1 FROM pg_database WHERE datname = '{DATABASE}'"]).stdout.strip()
    if exists != '1':
        run(['docker', 'compose', '-f', 'docker-compose.dev.yml', 'exec', '-T', 'postgres', 'createdb', '-U', 'aiqme', DATABASE])
    # migrate:fresh стирает БД: убеждаемся, что приложение действительно смотрит в aiqme_browser.
    database = run(['bin/php', 'artisan', 'config:show', 'database.connections.pgsql.database'], env=env).stdout.split()
    if not database or database[-1] != DATABASE:
        sys.exit(f'FAIL: приложение подключено не к {DATABASE}: {" ".join(database)}')
    run(['bin/php', 'artisan', 'migrate:fresh', '--force', '--no-interaction'], env=env)
    # Базовые данные Lunar (канал, EUR, налоговые зона и класс): без них заявка калькулятора не создаёт заказ (W-12).
    run(['bin/php', 'artisan', 'aiqme:bootstrap', '--no-interaction'], env=env)
    for seeder in CONTENT_SEEDERS:
        run(['bin/php', 'artisan', 'db:seed', f'--class={seeder}', '--force', '--no-interaction'], env=env)

    if not (APP / 'public' / 'storage').exists():
        run(['bin/php', 'artisan', 'storage:link', '--no-interaction'], env=env)

    admin_password = secrets.token_urlsafe(24)
    client_password = secrets.token_urlsafe(24)
    run(['bin/php', 'artisan', 'aiqme:make-admin', 'admin@aiqme.test', '--name=AIQME', '--password-stdin', '--no-interaction'],
        env=env, stdin=admin_password + '\n')
    seeded = run(['bin/php', 'artisan', 'db:seed', f'--class={BROWSER_SEEDER}', '--force', '--no-interaction'],
                 env={**env, 'BROWSER_CLIENT_PASSWORD': client_password}).stdout
    client = re.search(r'client-\d+@aiqme\.test', seeded)
    guest = re.search(r'/en/order/\d+/[A-Za-z0-9_-]{43}', seeded)
    if not client or not guest:
        sys.exit('FAIL: сидер tests/browser не создал клиента или гостевую ссылку')
    # Пароли и гостевая ссылка остаются только в памяти процесса; входят через форму входа (W-07).
    return {'admin': ('admin@aiqme.test', admin_password), 'client': (client.group(0), client_password), 'guest_url': guest.group(0)}


def build_assets():
    result = subprocess.run(['npm', 'run', 'build', '--silent'], cwd=APP, env=node_env(), text=True, capture_output=True)
    if result.returncode != 0:
        sys.exit(f'FAIL: npm run build\n{result.stdout[-2000:]}\n{result.stderr[-2000:]}')


def start_server(env):
    if port_in_use():
        sys.exit(f'FAIL: порт {PORT} занят — bin/browser-check работает только на нём; освободите порт')
    server = subprocess.Popen(
        # Как artisan serve: роутер Laravel берёт public/ из рабочего каталога.
        [str(APP / 'bin' / 'php'), '-S', HOST, str(APP / 'vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php')],
        cwd=APP / 'public', env={**env, 'PHP_CLI_SERVER_WORKERS': '4'}, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(100):
        try:
            urlopen(BASE + '/up', timeout=1)
            return server
        except OSError:
            time.sleep(0.1)
    server.kill()
    sys.exit('FAIL: сервер не ответил на /up')


def pages_from_sitemap():
    """Адреса сущностей (страницы услуг) — из sitemap.xml: slug берутся из БД, а не из кода."""
    xml = urlopen(BASE + '/sitemap.xml').read().decode()
    paths = [loc.removeprefix(BASE) for loc in re.findall(r'<loc>([^<]+)</loc>', xml)]
    return sorted(path for path in paths if path.count('/') > 2)


def pages_from_routes(env):
    routes = json.loads(run(['bin/php', 'artisan', 'route:list', '--json', '--method=GET'], env=env).stdout)
    public, skipped = [], []
    for route in routes:
        uri = route['uri']
        if '{' in uri:
            continue
        first = uri.split('/')[0]
        if '/' + uri in ADMIN_PAGES or '/' + uri in ORDER_CONFIRMATION_PAGES:
            continue
        if first in ('lt', 'en'):
            public.append('/' + uri)
        elif first == 'ru':
            skipped.append('/' + uri)
    return sorted(set(public)) + NOT_FOUND_PAGES, sorted(set(skipped))


# ---------- проверки в браузере ----------

class Report:
    def __init__(self):
        self.failures, self.notes, self.passed = [], [], 0
        self.external = set()

    def check(self, ok, message):
        if ok:
            self.passed += 1
        else:
            self.failures.append(message)
        return ok


def load_allowlist(file=ALLOWLIST):
    entries = json.loads(file.read_text(encoding='utf-8'))
    for entry in entries:
        if not (entry.get('page') and entry.get('phrase') and entry.get('reason')):
            sys.exit(f'FAIL: запись {file.name} без page/phrase/reason: {entry}')
    return entries


def marker_hits(page, path, allowlist):
    """Совпадения маркеров D-21 в видимом тексте и атрибутах; разрешённое — только фраза из allowlist этой страницы."""
    strings = page.evaluate("""(attributes) => {
        const texts = document.body.innerText.split('\\n').map((line) => line.trim()).filter(Boolean);
        for (const element of document.querySelectorAll('*')) {
            for (const name of attributes) {
                const value = name === 'value' && 'value' in element && element.tagName !== 'LI' ? element.value : element.getAttribute(name);
                if (value) texts.push(`[${name}] ${value}`);
            }
        }
        return texts;
    }""", MARKER_ATTRIBUTES)
    allowed = [entry['phrase'] for entry in allowlist if entry['page'] == path]
    hits = []
    for text in strings:
        lower = text.lower()
        for marker in MARKERS:
            for match in re.finditer(re.escape(marker), lower):
                covered = any(
                    start <= match.start() and match.end() <= start + len(phrase)
                    for phrase in allowed
                    for start in [m.start() for m in re.finditer(re.escape(phrase.lower()), lower)]
                )
                if not covered:
                    hits.append(f'«{marker}» в «{text[:160]}»')
    return sorted(set(hits))


def document_fits(page):
    return page.evaluate('[document.documentElement.scrollWidth, document.documentElement.clientWidth]')


def expected_styles(width):
    """Значения §7.1 из CSS прототипа (поздние media-блоки перекрывают ранние) для страниц оболочки."""
    phone, menu, compact = width <= 600, width <= 900, width <= 1150
    h1 = 37 if phone else min(max(36, width * 0.04), 56)  # .page-top h1: clamp(36px,4vw,56px); ≤600 — 37px
    return {
        'font': 'Arial, Helvetica, sans-serif',
        'body_size': 14 if phone else 15,
        'h1_size': h1,
        'head_main': 68 if phone else 75 if menu else 82,
        'head_sub': 38 if phone else 39,
        'wrap_padding': 20 if phone else 28 if compact else 48,
    }


STYLE_PROBE = """() => {
    const css = (selector, property) => { const el = document.querySelector(selector); return el ? getComputedStyle(el)[property] : null; };
    const root = getComputedStyle(document.documentElement);
    const h1 = document.querySelector('main h1');
    const h1s = h1 && getComputedStyle(h1);
    const visible = (el) => el && el.offsetParent !== null;
    return {
        tokens: Object.fromEntries(['--blue', '--ink', '--muted', '--line', '--soft', '--dark'].map((n) => [n, root.getPropertyValue(n).trim().toLowerCase()])),
        bodyFont: css('body', 'fontFamily'), bodySize: parseFloat(css('body', 'fontSize')), bodyLine: parseFloat(css('body', 'lineHeight')),
        bodyColor: css('body', 'color'),
        h1: h1s && {font: h1s.fontFamily, size: parseFloat(h1s.fontSize), weight: h1s.fontWeight, line: parseFloat(h1s.lineHeight), spacing: parseFloat(h1s.letterSpacing)},
        headMain: document.querySelector('.head-main').getBoundingClientRect().height,
        logo: document.querySelector('.header .logo').getBoundingClientRect().height,
        headSub: document.querySelector('.head-sub').getBoundingClientRect().height,
        wrapPadding: [parseFloat(css('.head-main', 'paddingLeft')), parseFloat(css('.head-main', 'paddingRight'))],
        wrapMax: css('.head-main', 'maxWidth'),
        ctaColor: visible(document.querySelector('.cta-link')) ? css('.cta-link', 'color') : null,
        headerBorder: css('.header', 'borderBottomColor'),
        pageTopBackground: css('.page-top', 'backgroundColor'),
        pageTopText: document.querySelector('.page-top p') ? css('.page-top p', 'color') : null,
        footerBackground: css('.footer', 'backgroundColor'),
        buttons: [...document.querySelectorAll('.btn:not(.small)')].filter(visible).map((b) => [b.getBoundingClientRect().height, getComputedStyle(b).borderRadius]),
        hero: !!document.querySelector('main .hero h1'),
        heroText: document.querySelector('.hero p') && (() => { const s = getComputedStyle(document.querySelector('.hero p'));
            return {size: parseFloat(s.fontSize), line: parseFloat(s.lineHeight), max: s.maxWidth, color: s.color}; })(),
        h1Max: h1s && h1s.maxWidth,
        h2: [...document.querySelectorAll('main h2')].filter(visible).map((h) => { const s = getComputedStyle(h);
            return {text: h.textContent.trim().slice(0, 40), size: parseFloat(s.fontSize), weight: s.fontWeight, line: parseFloat(s.lineHeight), spacing: parseFloat(s.letterSpacing)}; }),
        serviceCards: [...document.querySelectorAll('.service-feature-copy h3')].map((h) => { const s = getComputedStyle(h);
            return {size: parseFloat(s.fontSize), weight: s.fontWeight, line: parseFloat(s.lineHeight), spacing: parseFloat(s.letterSpacing)}; }),
    };
}"""

TOKENS = {'--blue': '#0867ff', '--ink': '#11171e', '--muted': '#64717e', '--line': '#dce2e8', '--soft': '#f3f6f9', '--dark': '#0a1119'}


def check_styles(report, page, path, width):
    expected = expected_styles(width)
    got = page.evaluate(STYLE_PROBE)
    where = f'{path} @{width}'
    near = lambda a, b: a is not None and abs(a - b) <= 2  # noqa: E731 — допуск ±2 px (§7.1)
    report.check(got['tokens'] == TOKENS, f'{where}: токены {got["tokens"]}')
    report.check(got['bodyFont'] == expected['font'], f'{where}: шрифт body {got["bodyFont"]}')
    report.check(near(got['bodySize'], expected['body_size']), f'{where}: размер body {got["bodySize"]} ≠ {expected["body_size"]}')
    report.check(near(got['bodyLine'], expected['body_size'] * 1.6), f'{where}: line-height body {got["bodyLine"]}')
    report.check(got['bodyColor'] == 'rgb(17, 23, 30)', f'{where}: цвет текста {got["bodyColor"]}')
    h1 = got['h1']
    # Hero (§7.1): h1 clamp(54px, 5.1vw, 82px), 1,06, −0,047em, max-width 950; абзац 21 px / 1,55, 650, #c2cad4; ≤700 — 52 и 18 px.
    h1_size, h1_line, h1_spacing = expected['h1_size'], 1.12, -0.045
    if got['hero']:
        h1_size, h1_line, h1_spacing = (52 if width <= 700 else min(max(54, width * 0.051), 82)), 1.06, -0.047
        report.check(got['h1Max'] == '950px', f'{where}: max-width h1 hero {got["h1Max"]}')
        text = got['heroText']
        if report.check(text is not None, f'{where}: нет абзаца hero'):
            size = 18 if width <= 700 else 21
            report.check(near(text['size'], size) and near(text['line'], size * 1.55), f'{where}: абзац hero {text["size"]}/{text["line"]} ≠ {size}/1.55')
            report.check(text['max'] == '650px' and text['color'] == 'rgb(194, 202, 212)', f'{where}: абзац hero {text["max"]} {text["color"]}')
    if report.check(h1 is not None, f'{where}: нет h1 в main'):
        report.check(h1['font'] == expected['font'], f'{where}: шрифт h1 {h1["font"]}')
        report.check(near(h1['size'], h1_size), f'{where}: размер h1 {h1["size"]} ≠ {h1_size:.1f}')
        report.check(h1['weight'] == '500', f'{where}: вес h1 {h1["weight"]}')
        report.check(near(h1['line'], h1['size'] * h1_line), f'{where}: line-height h1 {h1["line"]}')
        report.check(abs(h1['spacing'] - h1['size'] * h1_spacing) <= 0.1, f'{where}: letter-spacing h1 {h1["spacing"]}')
    for h2 in got['h2']:  # общие заголовки (§7.1): вес 500, 1,12, −0,045em
        report.check(h2['weight'] == '500' and near(h2['line'], h2['size'] * 1.12) and abs(h2['spacing'] - h2['size'] * -0.045) <= 0.1,
                     f'{where}: h2 «{h2["text"]}» {h2}')
    card_size = 30 if width <= 1050 else min(max(29, width * 0.026), 38)  # .service-feature-copy h3 (CSS прототипа)
    for card in got['serviceCards']:
        report.check(near(card['size'], card_size) and card['weight'] == '500' and near(card['line'], card['size'] * 1.13)
                     and abs(card['spacing'] - card['size'] * -0.04) <= 0.1, f'{where}: заголовок карточки услуги {card} ≠ {card_size:.1f}')
    report.check(near(got['headMain'], expected['head_main']), f'{where}: высота шапки {got["headMain"]} ≠ {expected["head_main"]}')
    report.check(0 < got['logo'] <= got['headMain'], f'{where}: логотип {got["logo"]}px не помещается в шапку')
    report.check(near(got['headSub'], expected['head_sub']), f'{where}: высота второго ряда {got["headSub"]} ≠ {expected["head_sub"]}')
    report.check(all(near(p, expected['wrap_padding']) for p in got['wrapPadding']), f'{where}: поля контейнера {got["wrapPadding"]} ≠ {expected["wrap_padding"]}')
    report.check(got['wrapMax'] == '1320px', f'{where}: ширина контейнера {got["wrapMax"]}')
    report.check(got['ctaColor'] in (None, 'rgb(8, 103, 255)'), f'{where}: цвет CTA {got["ctaColor"]}')
    report.check(got['headerBorder'] == 'rgb(220, 226, 232)', f'{where}: линия шапки {got["headerBorder"]}')
    report.check(got['pageTopBackground'] in (None, 'rgb(243, 246, 249)'), f'{where}: фон page-top {got["pageTopBackground"]}')
    report.check(got['pageTopText'] in (None, 'rgb(100, 113, 126)'), f'{where}: цвет вводного текста {got["pageTopText"]}')
    report.check(got['footerBackground'] == 'rgb(255, 255, 255)', f'{where}: подвал не светлый {got["footerBackground"]}')
    for height, radius in got['buttons']:
        report.check(height >= 48 and radius == '3px', f'{where}: кнопка {height}px, радиус {radius}')


def check_focus_style(report, page, path):
    page.keyboard.press('Tab')
    focus = page.evaluate("""() => { const el = document.activeElement; const s = getComputedStyle(el);
        return {cls: el.className, style: s.outlineStyle, width: s.outlineWidth, offset: s.outlineOffset, top: el.getBoundingClientRect().top}; }""")
    report.check(focus['cls'] == 'skip', f'{path}: первый Tab не на ссылке «к содержимому» ({focus["cls"]})')
    report.check((focus['style'], focus['width'], focus['offset']) == ('solid', '3px', '4px'), f'{path}: стиль фокуса {focus}')
    report.check(focus['top'] >= 0, f'{path}: ссылка «к содержимому» не видна при фокусе')


def check_menu(report, page, path, width, height):
    where = f'{path} @{width}'
    button, nav = page.locator('.menu-btn'), page.locator('#main-nav')
    expanded = lambda: button.get_attribute('aria-expanded')  # noqa: E731
    if width > 900:
        report.check(not button.is_visible() and nav.is_visible(), f'{where}: на широком экране меню должно быть строкой')
        return
    report.check(button.is_visible() and not nav.is_visible(), f'{where}: меню не свёрнуто')
    button.focus()
    page.keyboard.press('Enter')
    report.check(expanded() == 'true' and nav.is_visible(), f'{where}: Enter не открыл меню')
    report.check(page.evaluate("getComputedStyle(document.documentElement).overflowY") == 'hidden', f'{where}: фон прокручивается при открытом меню')
    box = nav.bounding_box()
    report.check(box['y'] + box['height'] <= height + 1 or nav.evaluate('(e) => e.scrollHeight > e.clientHeight'),
                 f'{where}: меню выходит за экран без своей прокрутки')
    links = nav.locator('a').count()
    page.keyboard.press('Shift+Tab')
    report.check(page.evaluate("document.activeElement === document.querySelector('#main-nav a:last-of-type')"), f'{where}: Shift+Tab с кнопки не на последний пункт')
    page.keyboard.press('Tab')
    report.check(page.evaluate("document.activeElement.classList.contains('menu-btn')"), f'{where}: Tab с последнего пункта не на кнопку')
    page.keyboard.press('Tab')
    report.check(page.evaluate("document.activeElement === document.querySelector('#main-nav a')"), f'{where}: Tab с кнопки не на первый пункт')
    for _ in range(links):
        page.keyboard.press('Tab')
    report.check(page.evaluate("document.activeElement.classList.contains('menu-btn')"), f'{where}: Tab ушёл из открытого меню')
    page.keyboard.press('Escape')
    report.check(expanded() == 'false', f'{where}: после Escape aria-expanded={expanded()} (F-46)')
    report.check(not nav.is_visible(), f'{where}: Escape не закрыл меню')
    report.check(page.evaluate("document.activeElement.classList.contains('menu-btn')"), f'{where}: после Escape фокус не на кнопке меню')
    report.check(page.evaluate("getComputedStyle(document.documentElement).overflowY") != 'hidden', f'{where}: после закрытия фон заблокирован')
    button.click()
    page.mouse.click(5, height - 5)
    report.check(expanded() == 'false' and not nav.is_visible(), f'{where}: щелчок вне меню не закрыл его')


def check_cookie(report, page, path):
    cookie = page.locator('.cookie')
    if not report.check(cookie.is_visible(), f'{path}: cookie-плашка не показана при первом визите'):
        return
    cookie.locator('[data-cookie-accept]').click()
    report.check(cookie.count() == 0, f'{path}: плашка не скрылась после «Tik būtini»')
    page.reload()
    report.check(not page.locator('.cookie').is_visible(), f'{path}: плашка вернулась после подтверждения')


def check_search_modal(report, new_page, path, width, height):
    """Поиск в шапке (searchPanel прототипа): окно, фокус в поле, живые результаты сервера, Escape и возврат фокуса."""
    where = f'{path} @{width} поиск'
    context, page, problems = new_page(width, height)
    page.goto(BASE + path, wait_until='networkidle')
    link = page.locator('.tools a[data-modal-open="search-modal"]')
    link.click()
    modal = page.locator('#search-modal')
    report.check(modal.is_visible() and page.url.rstrip('/') == BASE + path, f'{where}: окно не открылось или ушли со страницы')
    report.check(page.evaluate("document.activeElement.id === 'search-modal-input'"), f'{where}: фокус не в поле поиска')
    page.keyboard.type('model')
    try:
        page.wait_for_selector('#search-modal-results a.search-result', timeout=5000)
        names = page.locator('#search-modal-results a.search-result strong').all_inner_texts()
        report.check(any('model' in name.lower() for name in names), f'{where}: результаты без «model»: {names}')
    except Exception:  # noqa: BLE001 — таймаут ожидания и есть провал проверки
        report.check(False, f'{where}: результаты не появились')
    scroll, client = document_fits(page)
    report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
    page.keyboard.press('Escape')
    report.check(not modal.is_visible(), f'{where}: Escape не закрыл окно')
    report.check(page.evaluate("document.activeElement.matches('.tools a[data-modal-open]')"), f'{where}: фокус не вернулся на кнопку поиска')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


def check_compare(report, new_page, path, width, height):
    """Выбор для сравнения (F-04, resources/js/compare.js): 4 отметки — панель «4/4», пятая не ставится и выводится сообщение
    о пределе; выбор сохраняется после перезагрузки; «Compare» открывает сравнение с таблицей из 4 товаров."""
    where = f'{path} @{width} сравнение'
    context, page, problems = new_page(width, height)
    page.goto(BASE + path, wait_until='networkidle')
    # Cookie-плашка и панель сравнения — обе внизу экрана (как в прототипе); посетитель сначала закрывает плашку.
    page.locator('[data-cookie-accept]').click()
    bar = page.locator('[data-compare-bar]')
    boxes = page.locator('input[data-compare]')
    report.check(not bar.is_visible(), f'{where}: панель видна без выбора')
    report.check(boxes.count() >= 4, f'{where}: товаров для сравнения меньше 4 ({boxes.count()})')
    for index in range(min(4, boxes.count())):
        boxes.nth(index).check()
    report.check(bar.is_visible() and '4/4' in bar.inner_text(), f'{where}: панель не показывает 4/4')
    report.check(not page.locator('[data-compare-message]').is_visible(), f'{where}: сообщение о пределе до пятого')
    # Пятого товара в фабрике нет: предел проверяется на 4 slug в localStorage и отметке ещё одного товара.
    key = bar.get_attribute('data-compare-key')
    page.evaluate("(key) => localStorage.setItem(key, JSON.stringify(['a', 'b', 'c', 'd']))", key)
    page.reload(wait_until='networkidle')
    report.check('4/4' in bar.inner_text() and page.locator('input[data-compare]:checked').count() == 0,
                 f'{where}: выбор из localStorage не восстановлен')
    boxes.nth(0).click()
    report.check(not boxes.nth(0).is_checked() and page.locator('[data-compare-message]').is_visible(),
                 f'{where}: пятый товар выбран или нет сообщения о пределе')
    page.locator('[data-compare-clear]').click()
    report.check(not bar.is_visible(), f'{where}: «Clear comparison» не скрыл панель')
    for index in range(4):
        boxes.nth(index).check()
    page.reload(wait_until='networkidle')
    report.check(page.locator('input[data-compare]:checked').count() == 4, f'{where}: выбор не сохранился после перезагрузки')
    scroll, client = document_fits(page)
    report.check(scroll <= client, f'{where}: документ шире окна ({scroll} > {client})')
    page.locator('[data-compare-link]').click()
    page.wait_for_load_state('networkidle')
    report.check('products=' in page.url, f'{where}: выбор не в адресе сравнения: {page.url}')
    report.check(page.locator('main table thead th').count() == 5, f'{where}: в таблице сравнения не 4 товара')
    scroll, client = document_fits(page)
    report.check(scroll <= client, f'{where}: сравнение шире окна ({scroll} > {client})')
    for problem in problems:
        report.check(False, f'{where}: {problem}')
    context.close()


# ---------- W-05: порядок блоков, тексты эталона, медиа, движение ----------

BLOCKS_PROBE = """() => {
    const name = (el) => [el.tagName.toLowerCase(), ...el.classList].join('.');
    return [...document.querySelector('main').children].map((el) => el.classList.contains('wrap') && el.classList.contains('page-content')
        ? {[name(el)]: [...el.children].map(name)} : name(el));
}"""


def check_blocks(report, page, path, fixture):
    """Порядок прямых детей main (и div.wrap.page-content) — как в prototype-blocks.json (§7.1). Заголовок примера
    div.section-head на услугах сверяется, только если пример есть (опубликованный проект услуги, §4.1)."""
    expected = json.loads(json.dumps(fixture[path]))
    has_project = page.locator('main .project-card').count() > 0
    for entry in expected:
        if isinstance(entry, dict) and not has_project and re.match(r'^/(lt/paslaugos|en/services)/.', path):
            for children in entry.values():
                for i, child in enumerate(children):
                    if child == 'div.section-head' and i + 1 < len(children) and children[i + 1] == 'div.grid.two':
                        del children[i]
                        break
    got = page.evaluate(BLOCKS_PROBE)
    report.check(got == expected, f'{path}: порядок блоков {got} ≠ {expected}')


