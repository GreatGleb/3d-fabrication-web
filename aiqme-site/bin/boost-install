#!/usr/bin/env bash
# Установка правил и MCP-конфигураций Boost для Claude Code и Codex (D-17, W-01).
# Правила (AGENTS.md, CLAUDE.md — в Git) получают относительные команды bin/php …;
# локальные .mcp.json и .codex/config.toml (исключены .gitignore) — абсолютные пути к bin/php и artisan.
set -euo pipefail
app_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$app_root"

BOOST_PHP_EXECUTABLE_PATH=bin/php \
BOOST_COMPOSER_EXECUTABLE_PATH='bin/php /usr/local/bin/composer' \
BOOST_VENDOR_BIN_EXECUTABLE_PATH='bin/php vendor/bin/' \
    bin/php artisan boost:install --no-interaction

python3 - "$app_root" <<'PY'
import json, pathlib, sys

root = pathlib.Path(sys.argv[1])
php, artisan = str(root / 'bin/php'), str(root / 'artisan')

mcp_path = root / '.mcp.json'
mcp = json.loads(mcp_path.read_text()) if mcp_path.exists() else {'mcpServers': {}}
mcp.setdefault('mcpServers', {})['laravel-boost'] = {'command': php, 'args': [artisan, 'boost:mcp']}
mcp_path.write_text(json.dumps(mcp, indent=4) + '\n')

codex_dir = root / '.codex'
codex_dir.mkdir(exist_ok=True)
(codex_dir / 'config.toml').write_text(
    '[mcp_servers.laravel-boost]\n'
    f'command = {json.dumps(php)}\n'
    f'args = [{json.dumps(artisan)}, "boost:mcp"]\n'
    f'cwd = {json.dumps(str(root))}\n'
)
print(f'MCP: {mcp_path} и {codex_dir / "config.toml"} → {php} {artisan} boost:mcp')
PY
