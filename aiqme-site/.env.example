# Шаблон .env рабочей среды (W-20, §8.3, §6.6): на сервере — копия без секретов в Git, заполняется на месте
# (chown root:33 .env && chmod 0640 .env). Монтируется только для чтения в app, worker и scheduler; те же переменные
# подставляет docker compose (--env-file). Локальная разработка — bin/setup (значения dev поверх этого шаблона).
APP_NAME=AIQME
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://aiqme.com

APP_LOCALE=lt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Доверенные прокси (§6.6), не «*»: web на 127.0.0.1:<AIQME_WEB_PORT> — шлюз сети проекта
# (docker network inspect aiqme-prod_default --format '{{(index .IPAM.Config 0).Gateway}}'); после смены — optimize.
TRUSTED_PROXIES=

# PostgreSQL 17 сервиса db (этот же пароль получает контейнер db при первом запуске тома)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aiqme
DB_USERNAME=aiqme
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@aiqme.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# docker-compose.prod.yml: путь .env для монтирования, контекст сборки, порт web на 127.0.0.1 (его указывает общий
# прокси, docker/proxy/) и лимиты контейнеров (значения по умолчанию не измерены — W-29).
AIQME_ENV_FILE=./.env
AIQME_BUILD_CONTEXT=.
AIQME_WEB_PORT=8080
# AIQME_APP_MEMORY=1g
# AIQME_APP_CPUS=1.0
# AIQME_WORKER_MEMORY=768m
# AIQME_WORKER_CPUS=0.5
# AIQME_SCHEDULER_MEMORY=256m
# AIQME_SCHEDULER_CPUS=0.25
# AIQME_WEB_MEMORY=256m
# AIQME_WEB_CPUS=0.5
# AIQME_DB_MEMORY=512m
# AIQME_DB_CPUS=1.0

# Штатная панель Lunar (/lunar) — только инструмент разработчика в локальной среде (§2.3).
# В production маршрута /lunar нет независимо от значения.
AIQME_LUNAR_PANEL=false

# Формы обращений и регистрации на обучение (W-09): отправок с одного IP в час (обе формы вместе).
AIQME_FORMS_PER_HOUR=10

# Заявки на изготовление (W-12): отправок с одного IP в час; первый порядковый номер заказа.
AIQME_ORDERS_PER_HOUR=10
AIQME_ORDERS_FIRST_NUMBER=1

# Telegram-бот контента (W-19): токен бота от @BotFather и секрет webhook (1–256 символов A-Z a-z 0-9 _ -).
# Пусто — бот не подключён. Webhook регистрирует bin/php artisan aiqme:telegram-webhook (адрес APP_URL/webhooks/telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Stripe (W-16): публикуемый и секретный ключ test-режима (live — только в рабочей среде). Пусто — страница оплаты
# показывает «оплата временно недоступна». Таймаут вызова API, секунд. Секрет подписи webhook /webhooks/stripe (W-28):
# пусто — webhook отвечает 400.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_TIMEOUT=20
STRIPE_WEBHOOK_SECRET=

# Google Таблицы (W-18, §5.3): JSON ключа сервисного аккаунта Google одной строкой в base64 (base64 -w0 key.json)
# и ID таблицы из её адреса (…/spreadsheets/d/<ID>/edit). Сервисному аккаунту выдаётся доступ редактора к таблице,
# в ней — листы Orders, Requests, Contacts, Payments, Events. Пусто — Sheets не подключены, события копятся в outbox.
GOOGLE_SHEETS_KEY_BASE64=
GOOGLE_SHEETS_SPREADSHEET_ID=
