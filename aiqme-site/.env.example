APP_NAME=AIQME
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=lt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 17 из docker-compose.dev.yml (только 127.0.0.1)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55440
DB_DATABASE=aiqme
DB_USERNAME=aiqme
DB_PASSWORD=local-dev-only-not-a-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit из docker-compose.dev.yml: SMTP 127.0.0.1:51025, интерфейс http://127.0.0.1:58025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=51025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Штатная панель Lunar (/lunar) — только инструмент разработчика в локальной среде (§2.3).
# В production маршрута /lunar нет независимо от значения.
AIQME_LUNAR_PANEL=false

# Формы обращений и регистрации на обучение (W-09): отправок с одного IP в час (обе формы вместе).
AIQME_FORMS_PER_HOUR=10

# Заявки на изготовление (W-12): отправок с одного IP в час; первый порядковый номер заказа.
AIQME_ORDERS_PER_HOUR=10
AIQME_ORDERS_FIRST_NUMBER=1

# Telegram-бот контента (W-19): токен бота от @BotFather и секрет webhook (1–256 символов A-Z a-z 0-9 _ -).
# Пусто — бот не подключён. Webhook регистрирует bin/php artisan aiqme:telegram-webhook (адрес APP_URL/webhooks/telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Stripe (W-16): публикуемый и секретный ключ test-режима (live — только в рабочей среде). Пусто — страница оплаты
# показывает «оплата временно недоступна». Таймаут вызова API, секунд. Секрет подписи webhook /webhooks/stripe (W-28):
# пусто — webhook отвечает 400.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_TIMEOUT=20
STRIPE_WEBHOOK_SECRET=

# Google Таблицы (W-18, §5.3): JSON ключа сервисного аккаунта Google одной строкой в base64 (base64 -w0 key.json)
# и ID таблицы из её адреса (…/spreadsheets/d/<ID>/edit). Сервисному аккаунту выдаётся доступ редактора к таблице,
# в ней — листы Orders, Requests, Contacts, Payments, Events. Пусто — Sheets не подключены, события копятся в outbox.
GOOGLE_SHEETS_KEY_BASE64=
GOOGLE_SHEETS_SPREADSHEET_ID=
