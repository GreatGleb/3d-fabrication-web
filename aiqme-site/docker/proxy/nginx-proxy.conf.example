# Альтернатива Caddy (D-35): общий nginx-прокси хоста перед web AIQME на 127.0.0.1:<AIQME_WEB_PORT>.
# Журнал доступа — с тем же правилом $loggable, что в docker/nginx/default.conf, и без $http_referer (§6.2).
# TLS-сертификаты — средствами хоста (пути ниже — пример).

map $request_uri $aiqme_loggable {
    ~^/lt/uzsakymas/      0;
    ~^/en/order/          0;
    ~^/lt/paskyra/reset/  0;
    ~^/en/account/reset/  0;
    ~^/lt/apmokejimas/    0;
    ~^/en/checkout/       0;
    default               1;
}

log_format aiqme_proxy '$remote_addr [$time_local] "$request" $status $body_bytes_sent $request_time "$http_user_agent"';

server {
    listen 443 ssl;
    server_name aiqme.com;
    ssl_certificate     /etc/letsencrypt/live/aiqme.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aiqme.com/privkey.pem;

    access_log /var/log/nginx/aiqme-access.log aiqme_proxy if=$aiqme_loggable;
    client_max_body_size 260m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
